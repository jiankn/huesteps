{
  "name": "huesteps",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "content:build": "node scripts/build-content.mjs",
    "steps:build": "node scripts/generate-step-visuals.mjs --force",
    "steps:reviews:sync": "node scripts/audit-step-image-reviews.mjs --sync",
    "steps:reviews:approve": "node scripts/set-step-image-review.mjs",
    "steps:reviews:notes": "node scripts/generate-step-review-notes.mjs",
    "pins:build": "node scripts/generate-pins.mjs",
    "images:identity-contact-sheet": "node scripts/generate-model-identity-contact-sheet.mjs",
    "images:production-identity-qc": "node scripts/generate-production-identity-qc-sheet.mjs",
    "images:recipe-contact-sheet": "node scripts/generate-recipe-identity-contact-sheet.mjs",
    "images:normalize-texture": "node scripts/normalize-ai-image-texture.mjs",
    "images:normalize-step-set": "node scripts/normalize-progressive-step-sources.mjs",
    "images:prepare-heroes": "node scripts/prepare-model-identity-heroes.mjs",
    "audit:content": "node scripts/audit-content-quality.mjs",
    "audit:model-identities": "node scripts/audit-model-identity-registry.mjs --strict-assets",
    "audit:step-images:physical": "node scripts/audit-step-image-sets.mjs",
    "audit:step-images": "node scripts/audit-step-image-sets.mjs && node scripts/audit-step-image-reviews.mjs --strict",
    "check": "astro check",
    "build": "node scripts/build-content.mjs && node scripts/generate-step-visuals.mjs --force && node scripts/audit-step-image-sets.mjs && node scripts/audit-content-quality.mjs && node scripts/audit-step-image-reviews.mjs --strict && node scripts/audit-model-identity-registry.mjs --strict-assets && node scripts/generate-pins.mjs && astro check && astro build && node scripts/audit-build.mjs",
    "preview": "astro preview",
    "preview:dist": "node scripts/preview-dist.mjs",
    "qa:browser": "node scripts/browser-qa.mjs",
    "audit:indexing": "node scripts/audit-build.mjs",
    "cf:types": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply huesteps-pinterest-analytics --local"
  },
  "dependencies": {
    "@astrojs/rss": "latest",
    "@fontsource-variable/geist": "latest",
    "@fontsource-variable/newsreader": "^5.2.10",
    "@fontsource/allura": "^5.2.8",
    "astro": "latest",
    "sharp": "latest"
  },
  "devDependencies": {
    "@astrojs/check": "latest",
    "typescript": "^5.9.0",
    "wrangler": "^4.110.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@11.7.0"
}
