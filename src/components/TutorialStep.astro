---
import RecipeImage from './RecipeImage.astro';
import { getTutorialStepImage } from '@/lib/tutorial-step-images';

interface TutorialStepData {
  title: string;
  image: string;
  imageAlt: string;
  imageCaption: string;
  visualFocus:
    | 'full-face'
    | 'complexion'
    | 'brows'
    | 'both-eyes'
    | 'lid'
    | 'upper-lash'
    | 'lower-lash'
    | 'cheeks'
    | 'lips'
    | 'final';
  outcome: string;
  tool: string;
  productRole: string;
  action: string;
  placement: string;
  motion: string;
  amount: string;
  durationSeconds: number;
  whyItWorks: string;
  completeWhen: string;
  ifWrong: string;
  proTip: string;
  avoid: string;
}

interface Props {
  step: TutorialStepData;
  index: number;
  total: number;
}

const { step, index, total } = Astro.props;
const stepNumber = index + 1;
const titleId = `tutorial-step-${stepNumber}-title`;
const image = getTutorialStepImage(step.image);

const formatDuration = (seconds: number) => {
  if (seconds < 60) return `${seconds} sec`;

  const minutes = Math.round((seconds / 60) * 2) / 2;
  return `${minutes} min`;
};

const focusLabels: Record<TutorialStepData['visualFocus'], string> = {
  'full-face': 'Full face',
  complexion: 'Complexion',
  brows: 'Brows',
  'both-eyes': 'Both eyes',
  lid: 'Lids',
  'upper-lash': 'Lash line',
  'lower-lash': 'Lower lash',
  cheeks: 'Cheeks',
  lips: 'Lips',
  final: 'Full look'
};

const firstSentence = (value: string) => value.match(/^.*?[.!?](?:\s|$)/)?.[0]?.trim() ?? value;
const isPrepStep = /^Prepare for\b/i.test(step.title);
const displayTitle = isPrepStep ? 'Prep & settle' : step.title;
const displayAction = isPrepStep
  ? 'Let skincare settle, then blot only where skin still feels slippery.'
  : firstSentence(step.action);
const displayCheckpoint = isPrepStep ? 'Skin feels hydrated, not slick.' : step.completeWhen;
const compactTool = step.tool
  .replace(/^Clean fingertips\b.*$/i, 'Clean fingers')
  .replace(/^Small complexion sponge\b.*$/i, 'Small sponge')
  .replace(/^Fine brow tool\b.*$/i, 'Brow tool')
  .replace(/^Clean fingertip\b.*$/i, 'Fingertip')
  .replace(/^Small tapered blending brush\b.*$/i, 'Blending brush')
  .replace(/^Small flat shader brush\b.*$/i, 'Shader brush')
  .replace(/^Short dense liner brush\b.*$/i, 'Liner brush')
  .replace(/^Lash curler\b.*$/i, 'Lash curler')
  .replace(/^Small cream brush\b.*$/i, 'Cream brush')
  .replace(/^Clean short detail brush\b.*$/i, 'Detail brush')
  .replace(/^Clean blending brush\b.*$/i, 'Blending brush')
  .replace(/^Clean sponge\b.*$/i, 'Small sponge');
---

<li class="tutorial-step" data-tutorial-step data-step-number={stepNumber}>
  <article class="step-article" aria-labelledby={titleId}>
    <figure class="step-media" data-visual-focus={step.visualFocus}>
      <div class="step-image-frame">
        <RecipeImage
          src={image}
          alt={step.imageAlt}
          class="tutorial-step-picture"
          widths={[360, 640, 960, 1280]}
          sizes="(max-width: 47.99rem) calc(100vw - 1.2rem), (max-width: 80rem) 34vw, 31rem"
        />
      </div>
      <figcaption class="sr-only">{step.imageCaption}</figcaption>
    </figure>

    <div class="step-instructions">
      <header class="step-header">
        <span class="step-number" aria-hidden="true">{stepNumber}</span>
        <div>
          <p class="step-position">Step {stepNumber} of {total}</p>
          <h3 id={titleId}>{displayTitle}</h3>
        </div>
      </header>
      <p class="step-action">{displayAction}</p>
      <ul class="step-quick-facts" aria-label="Step essentials">
        <li>
          <svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18" fill="none">
            <circle cx="12" cy="8" r="4"></circle>
            <path d="M5.5 21c.5-5 2.6-7.5 6.5-7.5s6 2.5 6.5 7.5"></path>
          </svg>
          {focusLabels[step.visualFocus]}
        </li>
        <li>
          <svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18" fill="none">
            <circle cx="12" cy="12" r="9"></circle>
            <path d="M12 7v5l3 2"></path>
          </svg>
          <time datetime={`PT${step.durationSeconds}S`}>{formatDuration(step.durationSeconds)}</time>
        </li>
        <li>
          <svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18" fill="none">
            <path d="M8 20V9.5a1.5 1.5 0 0 1 3 0V13m0-6.5a1.5 1.5 0 0 1 3 0V13m0-5a1.5 1.5 0 0 1 3 0v6m0-3a1.5 1.5 0 0 1 3 0v4.5c0 3-2.5 5.5-5.5 5.5H13c-2.8 0-5-1.5-6.5-4L4 13.5a1.5 1.5 0 0 1 2.4-1.8L8 13"></path>
          </svg>
          {compactTool}
        </li>
      </ul>
    </div>

    <div class="completion-check">
      <svg aria-hidden="true" viewBox="0 0 24 24" width="20" height="20" fill="none">
        <circle cx="12" cy="12" r="9"></circle>
        <path d="m8 12 2.6 2.6L16.5 9"></path>
      </svg>
      <p><strong>Done when:</strong> {displayCheckpoint}</p>
    </div>

    <div class="step-actions" aria-label={`Actions for step ${stepNumber}`}>
      <button class="step-complete-button" type="button" data-step-complete aria-pressed="false">
        <svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18" fill="none">
          <circle cx="12" cy="12" r="9"></circle>
          <path d="m8 12 2.6 2.6L16.5 9"></path>
        </svg>
        <span>Mark complete</span>
      </button>
      <button class="step-fix-button" type="button" data-step-fix aria-expanded="false">
        Looks wrong? Fix it
      </button>
    </div>

    <details class="step-more" data-step-details>
      <summary>
        <span>More tips</span>
        <svg aria-hidden="true" viewBox="0 0 24 24" width="20" height="20" fill="none">
          <path d="m6 9 6 6 6-6"></path>
        </svg>
      </summary>
      <div class="step-more-body">
        <p class="step-outcome"><strong>Target result:</strong> {step.outcome}</p>

        <dl class="technique-facts">
          <div><dt>Tool</dt><dd>{step.tool}</dd></div>
          <div><dt>Product role</dt><dd>{step.productRole}</dd></div>
          <div><dt>Placement</dt><dd>{step.placement}</dd></div>
          <div><dt>Motion</dt><dd>{step.motion}</dd></div>
          <div><dt>Amount</dt><dd>{step.amount}</dd></div>
          <div><dt>Working time</dt><dd><time datetime={`PT${step.durationSeconds}S`}>{formatDuration(step.durationSeconds)}</time></dd></div>
        </dl>

        <p class="why-it-works"><strong>Why this works:</strong> {step.whyItWorks}</p>
        <p data-fix-target tabindex="-1"><strong>If it looks wrong:</strong> {step.ifWrong}</p>

        <aside class="step-guidance" aria-label={`Guidance for step ${stepNumber}`}>
          <p><strong>Pro tip:</strong> {step.proTip}</p>
          <p><strong>Avoid:</strong> {step.avoid}</p>
        </aside>

        <a class="full-size-link" href={image.src} target="_blank" rel="noopener" aria-label={`Open the full-size image for step ${stepNumber}`}>
          View full-size image
        </a>
      </div>
    </details>
  </article>
</li>

<style>
  .tutorial-step {
    min-width: 0;
  }

  .step-article {
    display: grid;
    min-width: 0;
    grid-template-columns: minmax(0, 0.76fr) minmax(0, 1.24fr);
    grid-template-areas:
      'media body'
      'check check'
      'actions actions'
      'more more';
    column-gap: 0.75rem;
    padding: 0.6rem;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: 0.625rem;
    background: var(--surface);
  }

  .step-media {
    grid-area: media;
    min-width: 0;
    min-height: 0;
    margin: 0;
  }

  .step-image-frame {
    position: relative;
    height: 100%;
    min-height: 7.25rem;
    overflow: hidden;
    border-radius: 0.45rem;
    background: var(--surface-soft);
  }

  .step-image-frame :global(.tutorial-step-picture) {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--focal-x, 50%) var(--focal-y, 50%);
  }

  .step-instructions {
    grid-area: body;
    display: grid;
    min-width: 0;
    align-content: start;
    gap: 0.4rem;
  }

  .step-header {
    display: flex;
    min-width: 0;
    align-items: baseline;
    gap: 0.55rem;
  }

  .step-header > div {
    min-width: 0;
  }

  .step-number {
    flex: 0 0 auto;
    color: var(--accent);
    font-family: var(--font-display);
    font-size: 1.75rem;
    font-weight: 450;
    line-height: 1;
  }

  .step-position {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .step-header h3 {
    margin: 0;
    font-size: clamp(1.2rem, 5.5vw, 1.5rem);
    font-weight: 520;
    line-height: 1.03;
    letter-spacing: -0.025em;
    text-wrap: balance;
  }

  .step-action {
    margin: 0;
    color: var(--text);
    font-size: 0.78rem;
    line-height: 1.38;
    text-wrap: pretty;
  }

  .step-quick-facts {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    min-width: 0;
    margin: auto 0 0;
    padding: 0.35rem 0 0;
    list-style: none;
  }

  .step-quick-facts li {
    display: flex;
    min-width: 0;
    min-height: 1.7rem;
    align-items: center;
    justify-content: center;
    padding-inline: 0.35rem;
    border-right: 1px solid var(--border);
    color: var(--text);
    font-size: 0.68rem;
    line-height: 1.2;
    text-align: center;
    overflow-wrap: anywhere;
  }

  .step-quick-facts li:last-child {
    border-right: 0;
  }

  .step-quick-facts svg {
    display: none;
    flex: 0 0 auto;
    stroke: currentColor;
    stroke-width: 1.45;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .completion-check {
    grid-area: check;
    display: grid;
    grid-template-columns: 1.25rem minmax(0, 1fr);
    gap: 0.65rem;
    align-items: center;
    margin-top: 0.6rem;
    padding: 0.55rem 0.7rem;
    border: 1px solid color-mix(in srgb, var(--accent) 20%, var(--border));
    border-radius: 0.4rem;
    background: color-mix(in srgb, var(--accent) 8%, var(--surface));
  }

  .completion-check svg {
    stroke: var(--accent);
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .completion-check p {
    margin: 0;
    color: var(--text);
    font-size: 0.76rem;
    line-height: 1.4;
    text-wrap: pretty;
  }

  .step-actions {
    grid-area: actions;
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  .step-actions button {
    display: inline-flex;
    min-height: 2.55rem;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    padding-inline: 0.85rem;
    border-radius: 0.3rem;
    font: inherit;
    font-size: 0.78rem;
    font-weight: 680;
    cursor: pointer;
    transition: background-color 180ms ease, border-color 180ms ease, color 180ms ease;
  }

  .step-complete-button {
    border: 1px solid var(--accent);
    background: var(--accent);
    color: var(--accent-contrast);
  }

  .step-complete-button svg {
    stroke: currentColor;
    stroke-width: 1.7;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .step-complete-button[aria-pressed='true'] {
    background: color-mix(in srgb, var(--accent) 10%, var(--surface));
    color: var(--accent);
  }

  .step-fix-button {
    border: 1px solid var(--border);
    background: transparent;
    color: var(--text);
  }

  .step-actions button:hover {
    border-color: var(--accent-hover);
  }

  .step-actions button:focus-visible,
  [data-fix-target]:focus-visible {
    outline: 3px solid color-mix(in srgb, var(--focus) 42%, transparent);
    outline-offset: 2px;
  }

  .tutorial-step.is-complete .step-article {
    border-color: color-mix(in srgb, var(--accent) 55%, var(--border));
  }

  .step-more {
    grid-area: more;
    min-width: 0;
    margin-top: 0.4rem;
    border-top: 1px solid var(--border);
  }

  .step-more summary {
    display: flex;
    min-height: 2.4rem;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    color: var(--text);
    cursor: pointer;
    font-size: 0.86rem;
    font-weight: 620;
    list-style: none;
  }

  .step-more summary::-webkit-details-marker {
    display: none;
  }

  .step-more summary::marker {
    content: '';
  }

  .step-more summary svg {
    flex: 0 0 auto;
    stroke: currentColor;
    stroke-width: 1.7;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: transform 180ms ease;
  }

  .step-more[open] summary svg {
    transform: rotate(180deg);
  }

  .step-more-body {
    display: grid;
    gap: 1rem;
    padding: 0.35rem 0 0.5rem;
  }

  .step-more-body p {
    margin: 0;
    font-size: 0.875rem;
    line-height: 1.55;
    text-wrap: pretty;
  }

  .technique-facts {
    display: grid;
    margin: 0;
    border-top: 1px solid var(--border);
  }

  .technique-facts > div {
    display: grid;
    gap: 0.2rem;
    padding-block: 0.65rem;
    border-bottom: 1px solid var(--border);
  }

  .technique-facts dt {
    color: var(--text);
    font-size: 0.75rem;
    font-weight: 720;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .technique-facts dd {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.84rem;
    line-height: 1.5;
  }

  .step-guidance {
    display: grid;
    gap: 0.75rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border);
  }

  .step-guidance p:last-child strong {
    color: var(--danger);
  }

  .full-size-link {
    width: fit-content;
    min-height: 2.75rem;
    display: inline-flex;
    align-items: center;
    color: var(--accent);
    font-size: 0.84rem;
    font-weight: 700;
    text-underline-offset: 0.2em;
  }

  @media (min-width: 48rem) {
    .step-article {
      grid-template-columns: minmax(17rem, 0.43fr) minmax(0, 0.57fr);
      grid-template-areas:
        'media body'
        'media check'
        'media actions'
        'media more';
      column-gap: clamp(1.5rem, 3vw, 2.25rem);
      padding: 0.75rem;
    }

    .step-image-frame {
      min-height: 13.5rem;
    }

    .step-number {
      display: none;
    }

    .step-header h3 {
      font-size: clamp(1.75rem, 2.5vw, 2.2rem);
    }

    .step-action {
      max-width: 62ch;
      font-size: 0.98rem;
      line-height: 1.55;
    }

    .step-quick-facts {
      display: flex;
      gap: 0;
      width: fit-content;
      padding-top: 0.8rem;
    }

    .step-quick-facts li {
      justify-content: flex-start;
      gap: 0.55rem;
      min-width: max-content;
      padding-inline: 1.1rem;
      font-size: 0.8rem;
      text-align: left;
      overflow-wrap: normal;
    }

    .step-quick-facts li:first-child {
      padding-left: 0;
    }

    .step-quick-facts svg {
      display: block;
    }

    .completion-check {
      margin-top: 0.8rem;
    }

    .technique-facts {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 1.5rem;
    }
  }

  @media (max-width: 47.99rem) {
    .step-article {
      grid-template-columns: 1fr;
      grid-template-areas:
        'media'
        'body'
        'check'
        'actions'
        'more';
      row-gap: 0.9rem;
    }

    .step-image-frame {
      min-height: 0;
      aspect-ratio: 4 / 3;
    }

    .step-media[data-visual-focus='brows'] :global(.tutorial-step-picture) {
      object-position: center 34%;
      transform: scale(1.34);
    }

    .step-media[data-visual-focus='both-eyes'] :global(.tutorial-step-picture),
    .step-media[data-visual-focus='lid'] :global(.tutorial-step-picture),
    .step-media[data-visual-focus='upper-lash'] :global(.tutorial-step-picture),
    .step-media[data-visual-focus='lower-lash'] :global(.tutorial-step-picture) {
      object-position: center 42%;
      transform: scale(1.62);
    }

    .step-media[data-visual-focus='cheeks'] :global(.tutorial-step-picture) {
      object-position: center 61%;
      transform: scale(1.36);
    }

    .step-media[data-visual-focus='lips'] :global(.tutorial-step-picture) {
      object-position: center 71%;
      transform: scale(1.72);
    }

    .step-media[data-visual-focus='final'] :global(.tutorial-step-picture) {
      object-position: center 48%;
      transform: scale(1.22);
    }

    .step-media[data-visual-focus='full-face'] :global(.tutorial-step-picture),
    .step-media[data-visual-focus='complexion'] :global(.tutorial-step-picture) {
      object-position: center 46%;
      transform: scale(1.08);
    }
  }

  @media (max-width: 23rem) {
    .step-quick-facts {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .step-more summary svg,
    .step-actions button {
      transition: none;
    }
  }
</style>
