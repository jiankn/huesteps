---
import '@fontsource-variable/geist';
import '@fontsource-variable/newsreader';
import '@fontsource/allura';
import '@/styles/global.css';
import Header from './Header.astro';
import Footer from './Footer.astro';
import { SITE } from '@/lib/site';

interface Props {
  title: string;
  description: string;
  image?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  schema?: Record<string, unknown> | Record<string, unknown>[];
  bodyClass?: string;
}

const {
  title,
  description,
  image = '/social/huesteps-default.png',
  type = 'website',
  noindex = false,
  schema,
  bodyClass
} = Astro.props;

const canonical = new URL(Astro.url.pathname, SITE.url).toString();
const fullTitle = title === SITE.name ? title : `${title} | ${SITE.name}`;
const deployPreview = import.meta.env.PUBLIC_DEPLOY_ENV === 'preview';
const robots = noindex || deployPreview ? 'noindex,follow' : 'index,follow,max-image-preview:large';
const analyticsToken = import.meta.env.PUBLIC_CLOUDFLARE_ANALYTICS_TOKEN;
const enablePinterestTracking = !noindex && !deployPreview;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#FAF8F3" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#171418" media="(prefers-color-scheme: dark)" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon-16.png?v=logo-20260711" sizes="16x16" type="image/png" />
    <link rel="icon" href="/favicon-32.png?v=logo-20260711" sizes="32x32" type="image/png" />
    <link rel="icon" href="/favicon-48.png?v=logo-20260711" sizes="48x48" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=logo-20260711" sizes="180x180" />
    <link rel="manifest" href="/site.webmanifest?v=logo-20260711" />
    <link rel="alternate" type="application/rss+xml" title="HueSteps recipes" href="/rss.xml" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(image, SITE.url).toString()} />
    <meta name="twitter:card" content="summary_large_image" />
    {schema && <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />}
    {analyticsToken && <script is:inline defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={`{&quot;token&quot;:&quot;${analyticsToken}&quot;}`} />}
  </head>
  <body class={bodyClass}>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <Header currentPath={Astro.url.pathname} />
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    <Footer />
    {enablePinterestTracking && <script is:inline>
      (() => {
        try {
          const navigatorWithPrivacySignals = navigator;
          if (
            navigatorWithPrivacySignals.globalPrivacyControl === true
            || navigator.doNotTrack === '1'
            || window.doNotTrack === '1'
          ) return;

          const pinterestDomains = ['pinterest.com', 'pin.it'];
          const isAllowedPinterestHost = (hostname) => {
            const normalized = hostname.toLowerCase().replace(/\.$/, '');
            return pinterestDomains.some((domain) => normalized === domain || normalized.endsWith(`.${domain}`));
          };

          const currentUrl = new URL(window.location.href);
          const utmSource = currentUrl.searchParams.get('utm_source')?.trim().toLowerCase() ?? '';
          let referrerUrl;
          try {
            referrerUrl = document.referrer ? new URL(document.referrer) : undefined;
          } catch {
            referrerUrl = undefined;
          }

          if (utmSource !== 'pinterest' && !isAllowedPinterestHost(referrerUrl?.hostname ?? '')) return;

          const path = currentUrl.pathname;
          const clean = (value, maxLength = 200) => value?.trim().slice(0, maxLength) || undefined;
          const utmCampaign = clean(currentUrl.searchParams.get('utm_campaign'), 160);
          const utmContent = clean(currentUrl.searchParams.get('utm_content'), 160);
          const pinId = clean(
            currentUrl.searchParams.get('pin_id')
            ?? currentUrl.searchParams.get('pin')
            ?? currentUrl.searchParams.get('utm_id'),
            100
          );
          const landingKey = [path, utmCampaign ?? '', utmContent ?? '', pinId ?? ''].join('|');
          let landingHash = 2166136261;
          for (let index = 0; index < landingKey.length; index += 1) {
            landingHash = Math.imul(landingHash ^ landingKey.charCodeAt(index), 16777619);
          }
          const sessionKey = `huesteps:pinterest:${(landingHash >>> 0).toString(36)}`;
          let sessionId;
          try {
            if (sessionStorage.getItem(sessionKey)) return;
          } catch {
            // Browsers may disable sessionStorage; tracking can still proceed once for this load.
          }

          if (!sessionId || !/^[A-Za-z0-9_-]{16,128}$/.test(sessionId)) {
            sessionId = crypto.randomUUID
              ? crypto.randomUUID().replaceAll('-', '')
              : Array.from(crypto.getRandomValues(new Uint8Array(16)), (byte) => byte.toString(16).padStart(2, '0')).join('');
          }

          try {
            sessionStorage.setItem(sessionKey, sessionId);
          } catch {
            // The server still receives a valid ephemeral session ID when storage is unavailable.
          }

          const payload = JSON.stringify({
            path,
            landingPath: path,
            sessionId,
            utmSource: utmSource || undefined,
            utmCampaign,
            utmContent,
            pinId,
            referrer: referrerUrl ? `${referrerUrl.origin}${referrerUrl.pathname}`.slice(0, 500) : undefined
          });

          if (navigator.sendBeacon) {
            navigator.sendBeacon('/api/pinterest/track', new Blob([payload], { type: 'application/json' }));
            return;
          }

          void fetch('/api/pinterest/track', {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: payload,
            keepalive: true,
            credentials: 'same-origin'
          }).catch(() => {});
        } catch {
          // Analytics must never interfere with the content experience.
        }
      })();
    </script>}
  </body>
</html>
