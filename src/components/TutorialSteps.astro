---
import TutorialStep from './TutorialStep.astro';

interface TutorialStepData {
  title: string;
  image: string;
  imageAlt: string;
  imageCaption: string;
  visualFocus:
    | 'full-face'
    | 'complexion'
    | 'brows'
    | 'both-eyes'
    | 'lid'
    | 'upper-lash'
    | 'lower-lash'
    | 'cheeks'
    | 'lips'
    | 'final';
  outcome: string;
  tool: string;
  productRole: string;
  action: string;
  placement: string;
  motion: string;
  amount: string;
  durationSeconds: number;
  whyItWorks: string;
  completeWhen: string;
  ifWrong: string;
  proTip: string;
  avoid: string;
}

interface Props {
  steps: TutorialStepData[];
  title?: string;
}

const { steps, title = 'Follow the steps' } = Astro.props;
---

<section id="steps" class="tutorial-section" tabindex="-1" aria-labelledby="tutorial-steps-title">
  <header class="tutorial-heading">
    <h2 id="tutorial-steps-title">{title}</h2>
    <p>Step 1 of {steps.length}</p>
  </header>

  <ol class="tutorial-list" aria-label={`${title}: ${steps.length} steps`}>
    {steps.map((step, index) => <TutorialStep step={step} index={index} total={steps.length} />)}
  </ol>
</section>

<style>
  .tutorial-section {
    min-width: 0;
    scroll-margin-top: calc(var(--header-height) + 1.5rem);
    margin-bottom: clamp(4rem, 8vw, 6.5rem);
  }

  .tutorial-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1.5rem;
    margin-bottom: 0.75rem;
    padding-bottom: 0.65rem;
    border-bottom: 1px solid var(--border);
  }

  .tutorial-heading h2 {
    margin: 0;
    font-size: clamp(2rem, 4vw, 2.75rem);
    font-weight: 500;
    text-wrap: balance;
  }

  .tutorial-heading p {
    flex: 0 0 auto;
    margin: 0;
    color: var(--text);
    font-size: 0.85rem;
    font-variant-numeric: tabular-nums;
  }

  .tutorial-list {
    display: grid;
    min-width: 0;
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (max-width: 47.99rem) {
    .tutorial-heading {
      display: grid;
      gap: 0.25rem;
      align-items: start;
      margin-bottom: 1rem;
    }

    .tutorial-heading h2 {
      font-size: clamp(2rem, 10vw, 2.65rem);
    }
  }
</style>
