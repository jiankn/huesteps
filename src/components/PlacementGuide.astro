---
interface Palette {
  name: string;
  hex: string;
  role: string;
  placement: string;
}

interface Props {
  palette: Palette[];
  notes: string[];
  title: string;
}

const { palette, notes, title } = Astro.props;

// Classify anatomical placement zones for each color
function analyzeZone(item: Palette, index: number) {
  const text = `${item.placement} ${item.role}`.toLowerCase();
  
  const isCrease = text.includes('crease') || text.includes('socket') || text.includes('fold') || text.includes('transition') || text.includes('above the natural');
  const isLashline = text.includes('lash') || text.includes('liner') || text.includes('roots') || text.includes('tightline') || text.includes('definition');
  const isInner = text.includes('inner') || text.includes('tear duct') || text.includes('brightener') || text.includes('champagne');
  const isOuter = text.includes('outer') || text.includes('corner') || text.includes('wing') || text.includes('angle');
  const isLid = text.includes('lid') || text.includes('mobile') || text.includes('accent') || (!isCrease && !isLashline && !text.includes('cheek') && !text.includes('lip'));
  const isCheek = text.includes('cheek') || text.includes('blush');
  const isLip = text.includes('lip');

  // Eye SVG pin coordinates (viewBox 0 0 520 340)
  let eyePin = { x: 260, y: 145, label: 'Mobile Lid' };
  if (isLashline && isOuter) {
    eyePin = { x: 385, y: 172, label: 'Outer Lash Line' };
  } else if (isLashline) {
    eyePin = { x: 260, y: 168, label: 'Lash Roots' };
  } else if (isInner && !isLid) {
    eyePin = { x: 130, y: 192, label: 'Tear Duct / Inner Corner' };
  } else if (isCrease) {
    eyePin = { x: 260, y: 98, label: 'Above Crease' };
  } else if (isOuter && isLid) {
    eyePin = { x: 355, y: 148, label: 'Outer Lid' };
  } else if (isInner && isLid) {
    eyePin = { x: 200, y: 148, label: 'Inner Lid' };
  } else if (isLid) {
    eyePin = { x: 260, y: 145, label: 'Lid Center' };
  }

  // Face SVG pin coordinates (viewBox 0 0 240 280)
  let facePin: { x: number; y: number; label: string } | null = null;
  if (isCheek && isLip) {
    facePin = { x: 145, y: 118, label: 'Cheek & Lips' };
  } else if (isCheek) {
    facePin = { x: 155, y: 118, label: 'Upper Cheekbone' };
  } else if (isLip) {
    facePin = { x: 120, y: 196, label: 'Lips Center' };
  }

  return {
    ...item,
    index: index + 1,
    isCrease,
    isLashline,
    isInner,
    isOuter,
    isLid,
    isCheek,
    isLip,
    eyePin,
    facePin,
    hasFaceMapping: isCheek || isLip,
    hasEyeMapping: isCrease || isLashline || isInner || isOuter || isLid || (!isCheek && !isLip)
  };
}

const zones = palette.slice(0, 3).map((item, index) => analyzeZone(item, index));
const hasAnyFacePlacement = zones.some((z) => z.hasFaceMapping);
---

<figure class="placement-guide-revamp" aria-labelledby="placement-heading">
  <header class="placement-header">
    <div class="placement-title-wrap">
      <span class="placement-tag">Anatomical Zone Map</span>
      <h3 id="placement-heading">{title} Placement Guide</h3>
    </div>
    <p class="placement-instruction">
      Interactive mapping of color placement, blend boundaries, and facial architecture. Hover or tap any zone to spotlight its application area.
    </p>
  </header>

  <div class="placement-workbench">
    <!-- Visual Anatomy Diagrams Container -->
    <div class="placement-visuals" aria-label="Visual anatomical map of makeup application">
      <!-- Main Eye Anatomy Diagram -->
      <div class="anatomy-card eye-anatomy-card" data-diagram="eye">
        <div class="anatomy-card-header">
          <span class="anatomy-view-badge">👁️ Eye Architecture</span>
          <span class="anatomy-view-note">Open-eye perspective</span>
        </div>
        
        <div class="svg-container eye-svg-wrapper">
          <svg viewBox="0 0 520 340" class="anatomy-svg eye-svg" role="img" aria-label="Eye anatomy placement diagram">
            <defs>
              <!-- Soft blur filters for realistic makeup diffusion -->
              <filter id="soft-crease-glow" x="-20%" y="-20%" width="140%" height="140%">
                <feGaussianBlur stdDeviation="16" result="blur" />
              </filter>
              <filter id="lid-glow" x="-20%" y="-20%" width="140%" height="140%">
                <feGaussianBlur stdDeviation="12" result="blur" />
              </filter>
              <filter id="liner-glow" x="-20%" y="-20%" width="140%" height="140%">
                <feGaussianBlur stdDeviation="5" result="blur" />
              </filter>
              <filter id="inner-glow" x="-20%" y="-20%" width="140%" height="140%">
                <feGaussianBlur stdDeviation="8" result="blur" />
              </filter>

              <!-- Dynamic gradients for each active zone -->
              {zones.map((zone) => (
                <>
                  <radialGradient id={`zone-grad-lid-${zone.index}`} cx="50%" cy="50%" r="50%">
                    <stop offset="0%" stop-color={zone.hex} stop-opacity="0.85" />
                    <stop offset="65%" stop-color={zone.hex} stop-opacity="0.45" />
                    <stop offset="100%" stop-color={zone.hex} stop-opacity="0" />
                  </radialGradient>
                  <linearGradient id={`zone-grad-crease-${zone.index}`} x1="0%" y1="100%" x2="0%" y2="0%">
                    <stop offset="0%" stop-color={zone.hex} stop-opacity="0.75" />
                    <stop offset="70%" stop-color={zone.hex} stop-opacity="0.3" />
                    <stop offset="100%" stop-color={zone.hex} stop-opacity="0" />
                  </linearGradient>
                  <linearGradient id={`zone-grad-lash-${zone.index}`} x1="0%" y1="0%" x2="100%" y2="0%">
                    <stop offset="0%" stop-color={zone.hex} stop-opacity="0.4" />
                    <stop offset="60%" stop-color={zone.hex} stop-opacity="0.85" />
                    <stop offset="100%" stop-color={zone.hex} stop-opacity="0.95" />
                  </linearGradient>
                </>
              ))}
            </defs>

            <!-- Background Skin Canvas -->
            <rect x="0" y="0" width="520" height="340" class="skin-canvas" rx="16" />

            <!-- Dynamic Makeup Color Layers -->
            <g class="makeup-layers">
              {zones.map((zone) => (
                <g class={`zone-layer zone-layer-${zone.index}`} data-zone-id={zone.index}>
                  {/* Crease / Transition Layer */}
                  {zone.isCrease && (
                    <path
                      d="M 105,145 C 150,70 340,65 415,135 C 375,95 185,100 105,145 Z"
                      fill={`url(#zone-grad-crease-${zone.index})`}
                      filter="url(#soft-crease-glow)"
                      class="blend-layer crease-blend"
                    />
                  )}

                  {/* Mobile Lid Layer */}
                  {zone.isLid && !zone.isInner && (
                    <ellipse
                      cx={zone.isOuter ? 340 : 255}
                      cy="150"
                      rx={zone.isOuter ? 75 : 95}
                      ry="42"
                      fill={`url(#zone-grad-lid-${zone.index})`}
                      filter="url(#lid-glow)"
                      class="blend-layer lid-blend"
                    />
                  )}

                  {/* Inner Corner / Tear Duct Layer */}
                  {zone.isInner && (
                    <ellipse
                      cx="145"
                      cy="185"
                      rx="45"
                      ry="30"
                      fill={`url(#zone-grad-lid-${zone.index})`}
                      filter="url(#inner-glow)"
                      class="blend-layer inner-blend"
                    />
                  )}

                  {/* Lash Line & Outer V Layer */}
                  {zone.isLashline && (
                    <path
                      d="M 125,188 C 190,145 320,145 408,172 C 430,165 442,154 448,146 C 438,168 412,185 390,192 C 310,210 190,205 125,188 Z"
                      fill={zone.hex}
                      opacity="0.8"
                      filter="url(#liner-glow)"
                      class="blend-layer lash-blend"
                    />
                  )}
                </g>
              ))}
            </g>

            <!-- Anatomical Guide Line Art -->
            <g class="anatomy-lines">
              <!-- Eyebrow -->
              <path
                d="M 100,56 C 145,40 230,32 320,38 C 385,44 430,70 450,92 C 415,74 360,56 310,54 C 220,52 145,62 100,56 Z"
                class="line-brow"
              />
              
              <!-- Orbital Socket Crease -->
              <path
                d="M 115,142 C 180,82 335,82 410,138"
                class="line-crease"
              />

              <!-- Upper Eyelid / Lash Margin -->
              <path
                d="M 118,188 C 185,138 325,138 412,174 C 428,168 440,158 446,150"
                class="line-upper-lash"
              />

              <!-- Eyeball Contour (Iris & Pupil) -->
              <g class="iris-assembly">
                <circle cx="260" cy="176" r="48" class="line-iris-outer" />
                <circle cx="260" cy="176" r="46" class="iris-fill" />
                <circle cx="260" cy="176" r="20" class="line-pupil" />
                <ellipse cx="248" cy="164" rx="7" ry="5" class="iris-catchlight" />
              </g>

              <!-- Tear Duct (Inner Canthus) -->
              <path
                d="M 118,188 C 102,194 106,202 120,204"
                class="line-canthus"
              />

              <!-- Lower Lashline / Under-Eye Contour -->
              <path
                d="M 120,204 C 195,228 325,226 412,174"
                class="line-lower-lash"
              />

              <!-- Eyelashes Accents -->
              <path d="M 405,170 Q 425,152 438,142" class="lash-accent" />
              <path d="M 375,152 Q 390,132 400,122" class="lash-accent" />
              <path d="M 340,142 Q 350,122 355,112" class="lash-accent" />
              <path d="M 300,138 Q 305,118 305,108" class="lash-accent" />
            </g>

            <!-- Anatomical Zone Badges & Pointers -->
            <g class="zone-badges">
              {zones.map((zone) => {
                if (!zone.hasEyeMapping && zone.hasFaceMapping) return null;
                return (
                  <g class={`pin-group pin-group-${zone.index}`} data-zone-id={zone.index} transform={`translate(${zone.eyePin.x}, ${zone.eyePin.y})`}>
                    <circle r="22" class="pin-halo" style={`--pin-color:${zone.hex}`} />
                    <circle r="14" class="pin-base" style={`--pin-color:${zone.hex}`} />
                    <text text-anchor="middle" dy="4.5" class="pin-text">{zone.index}</text>
                    <!-- Zone Pin Label Tooltip -->
                    <g class="pin-label-tag" transform="translate(0, -26)">
                      <rect x="-44" y="-14" width="88" height="20" rx="10" class="pin-tag-bg" />
                      <text text-anchor="middle" dy="-0.5" class="pin-tag-text">{zone.eyePin.label}</text>
                    </g>
                  </g>
                );
              })}
            </g>
          </svg>
        </div>
      </div>

      <!-- Optional Face & Lip Harmony Diagram (rendered when cheek/lip colors exist) -->
      {hasAnyFacePlacement && (
        <div class="anatomy-card face-anatomy-card" data-diagram="face">
          <div class="anatomy-card-header">
            <span class="anatomy-view-badge">✨ Cheek & Lip Balance</span>
            <span class="anatomy-view-note">Facial contour mapping</span>
          </div>

          <div class="svg-container face-svg-wrapper">
            <svg viewBox="0 0 240 280" class="anatomy-svg face-svg" role="img" aria-label="Cheek and lip placement diagram">
              <defs>
                <filter id="cheek-glow" x="-30%" y="-30%" width="160%" height="160%">
                  <feGaussianBlur stdDeviation="14" result="blur" />
                </filter>
                <filter id="lip-glow" x="-20%" y="-20%" width="140%" height="140%">
                  <feGaussianBlur stdDeviation="6" result="blur" />
                </filter>
              </defs>

              <!-- Face Canvas Background -->
              <rect x="0" y="0" width="240" height="280" class="skin-canvas" rx="16" />

              <!-- Face Makeup Layers -->
              <g class="face-makeup-layers">
                {zones.map((zone) => {
                  if (!zone.hasFaceMapping) return null;
                  return (
                    <g class={`zone-layer zone-layer-${zone.index}`} data-zone-id={zone.index}>
                      {zone.isCheek && (
                        <ellipse
                          cx="155"
                          cy="118"
                          rx="46"
                          ry="26"
                          transform="rotate(-18 155 118)"
                          fill={zone.hex}
                          opacity="0.65"
                          filter="url(#cheek-glow)"
                          class="blend-layer cheek-blend"
                        />
                      )}
                      {zone.isLip && (
                        <path
                          d="M 88,188 C 100,182 108,184 120,188 C 132,184 140,182 152,188 C 144,198 128,206 120,206 C 112,206 96,198 88,188 Z"
                          fill={zone.hex}
                          opacity="0.8"
                          filter="url(#lip-glow)"
                          class="blend-layer lip-blend"
                        />
                      )}
                    </g>
                  );
                })}
              </g>

              <!-- Minimalist Editorial Face Line Art -->
              <g class="face-lines">
                <!-- Face Oval Contour (Half/3/4 profile) -->
                <path d="M 60,35 C 130,22 185,45 200,95 C 212,140 195,195 160,235 C 140,256 120,265 105,268" class="line-face-contour" />
                <!-- Nose Bridge & Tip -->
                <path d="M 105,80 C 108,115 102,138 95,145 C 103,148 114,146 118,142" class="line-nose" />
                <!-- Subtle Eye Silhouette for Reference -->
                <path d="M 130,85 C 145,75 165,78 175,88" class="line-ref-eye" />
                <path d="M 134,88 C 146,95 165,95 174,88" class="line-ref-eye" />
                <!-- Cheekbone Uplift Guideline -->
                <path d="M 125,130 C 145,115 172,105 190,102" class="line-guide-dash" stroke-dasharray="3 3" />
                <!-- Lip Contour Lines -->
                <path d="M 94,188 C 104,184 112,185 120,188 C 128,185 136,184 146,188" class="line-lip-cupid" />
                <path d="M 94,188 C 108,198 132,198 146,188" class="line-lip-lower" />
              </g>

              <!-- Face Zone Badges -->
              <g class="face-zone-badges">
                {zones.map((zone) => {
                  if (!zone.facePin) return null;
                  return (
                    <g class={`pin-group pin-group-${zone.index}`} data-zone-id={zone.index} transform={`translate(${zone.facePin.x}, ${zone.facePin.y})`}>
                      <circle r="18" class="pin-halo" style={`--pin-color:${zone.hex}`} />
                      <circle r="12" class="pin-base" style={`--pin-color:${zone.hex}`} />
                      <text text-anchor="middle" dy="4" class="pin-text">{zone.index}</text>
                      <g class="pin-label-tag" transform="translate(0, -22)">
                        <rect x="-38" y="-12" width="76" height="18" rx="9" class="pin-tag-bg" />
                        <text text-anchor="middle" dy="-0.5" class="pin-tag-text">{zone.facePin.label}</text>
                      </g>
                    </g>
                  );
                })}
              </g>
            </svg>
          </div>
        </div>
      )}
    </div>

    <!-- Structured Palette Cards & Directives -->
    <div class="placement-legend">
      <div class="legend-header">
        <h4 class="legend-title">Step Palette & Targeted Placement</h4>
        <span class="legend-subtitle">Harmonized formula and anatomical target</span>
      </div>

      <ol class="placement-cards-list">
        {zones.map((zone) => (
          <li class={`placement-card zone-card-${zone.index}`} data-zone-id={zone.index} tabindex="0">
            <div class="card-indicator">
              <span class="card-pin" style={`--swatch-color:${zone.hex}`}>
                {zone.index}
              </span>
            </div>
            
            <div class="card-main">
              <div class="card-top-row">
                <h5 class="shade-name">{zone.name}</h5>
                <span class="role-badge">{zone.role}</span>
              </div>

              <div class="card-placement-detail">
                <span class="placement-target-pin" aria-hidden="true">📍</span>
                <span class="placement-target-text">{zone.placement}</span>
              </div>
            </div>
          </li>
        ))}
      </ol>

      <!-- Editorial Placement Guidelines -->
      <div class="placement-directives-panel">
        <h5 class="directives-title">Pro Application Directives</h5>
        <ul class="directives-list">
          {notes.map((note) => (
            <li>{note}</li>
          ))}
        </ul>
        <p class="directives-note">
          💡 The numbered pins, anatomical diagrams, and written directives carry synchronized instructions. Click or hover any card to spotlight the exact region.
        </p>
      </div>
    </div>
  </div>
</figure>

<script>
  // Client-side interactive spotlight logic
  function initPlacementGuide() {
    const guides = document.querySelectorAll('.placement-guide-revamp');
    
    guides.forEach((guide) => {
      const cards = guide.querySelectorAll('.placement-card');
      const layers = guide.querySelectorAll('.zone-layer');
      const pins = guide.querySelectorAll('.pin-group');

      function setActiveZone(zoneId: string | null) {
        if (!zoneId) {
          cards.forEach((c) => c.classList.remove('is-active'));
          layers.forEach((l) => l.classList.remove('is-active', 'is-dimmed'));
          pins.forEach((p) => p.classList.remove('is-active', 'is-dimmed'));
          return;
        }

        cards.forEach((c) => {
          c.classList.toggle('is-active', c.getAttribute('data-zone-id') === zoneId);
        });

        layers.forEach((l) => {
          const match = l.getAttribute('data-zone-id') === zoneId;
          l.classList.toggle('is-active', match);
          l.classList.toggle('is-dimmed', !match);
        });

        pins.forEach((p) => {
          const match = p.getAttribute('data-zone-id') === zoneId;
          p.classList.toggle('is-active', match);
          p.classList.toggle('is-dimmed', !match);
        });
      }

      // Card event listeners
      cards.forEach((card) => {
        const zoneId = card.getAttribute('data-zone-id');
        
        card.addEventListener('mouseenter', () => setActiveZone(zoneId));
        card.addEventListener('focus', () => setActiveZone(zoneId));
        card.addEventListener('click', () => setActiveZone(zoneId));
      });

      // Pin event listeners
      pins.forEach((pin) => {
        const zoneId = pin.getAttribute('data-zone-id');
        
        pin.addEventListener('mouseenter', () => setActiveZone(zoneId));
        pin.addEventListener('click', () => setActiveZone(zoneId));
      });

      // Reset when pointer leaves the whole guide
      guide.addEventListener('mouseleave', () => setActiveZone(null));
    });
  }

  // Support initial load & client navigation (view transitions)
  initPlacementGuide();
  document.addEventListener('astro:page-load', initPlacementGuide);
</script>

<style>
  /* ==========================================================================
     Placement Guide Revamp Styles - Luxury Editorial & Functional Anatomy
     ========================================================================== */

  .placement-guide-revamp {
    margin: 24px 28px 28px !important;
    padding: 24px;
    border: 1px solid var(--border);
    border-radius: 12px;
    background: var(--surface);
    box-shadow: 0 4px 24px -2px rgba(0, 0, 0, 0.04);
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }

  /* Header */
  .placement-header {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--border);
  }

  .placement-tag {
    display: inline-flex;
    align-items: center;
    width: fit-content;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent, #a9676b);
    margin-bottom: 0.25rem;
  }

  .placement-title-wrap h3 {
    margin: 0;
    font-family: var(--font-serif, serif);
    font-size: clamp(1.4rem, 2.5vw, 1.85rem);
    font-weight: 600;
    color: var(--text);
    line-height: 1.25;
  }

  .placement-instruction {
    margin: 0;
    font-size: 0.92rem;
    color: var(--text-muted);
    line-height: 1.5;
    max-width: 75ch;
  }

  /* Workbench Split Layout */
  .placement-workbench {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    gap: 2rem;
    align-items: start;
  }

  /* Visual Anatomy Cards */
  .placement-visuals {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .anatomy-card {
    background: var(--surface-soft, #faf8f5);
    border: 1px solid var(--border);
    border-radius: 10px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .anatomy-card:hover {
    border-color: color-mix(in srgb, var(--accent, #a9676b) 35%, var(--border));
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.06);
  }

  .anatomy-card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.75rem 1.15rem;
    background: color-mix(in srgb, var(--surface) 60%, var(--surface-soft));
    border-bottom: 1px solid var(--border);
    font-size: 0.8rem;
  }

  .anatomy-view-badge {
    font-weight: 600;
    color: var(--text);
  }

  .anatomy-view-note {
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  .svg-container {
    padding: 0.75rem 1rem 1rem;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .anatomy-svg {
    width: 100%;
    height: auto;
    max-height: 280px;
    display: block;
    user-select: none;
  }

  /* SVG Internal Anatomy Styles */
  .skin-canvas {
    fill: color-mix(in srgb, var(--surface-soft) 85%, var(--surface));
  }

  :global(.dark) .skin-canvas {
    fill: #1a1818;
  }

  .line-brow {
    fill: var(--text);
    opacity: 0.65;
  }

  .line-crease {
    fill: none;
    stroke: var(--text);
    stroke-width: 1.5;
    stroke-dasharray: 4 3;
    opacity: 0.55;
  }

  .line-upper-lash {
    fill: none;
    stroke: var(--text);
    stroke-width: 3.2;
    stroke-linecap: round;
    opacity: 0.9;
  }

  .line-iris-outer {
    fill: none;
    stroke: var(--text);
    stroke-width: 1.5;
    opacity: 0.4;
  }

  .iris-fill {
    fill: color-mix(in srgb, var(--text) 25%, var(--surface-soft));
  }

  .line-pupil {
    fill: var(--text);
    opacity: 0.85;
  }

  .iris-catchlight {
    fill: #ffffff;
    opacity: 0.9;
  }

  .line-canthus {
    fill: none;
    stroke: var(--text);
    stroke-width: 1.8;
    opacity: 0.7;
  }

  .line-lower-lash {
    fill: none;
    stroke: var(--text);
    stroke-width: 1.6;
    stroke-linecap: round;
    opacity: 0.75;
  }

  .lash-accent {
    fill: none;
    stroke: var(--text);
    stroke-width: 1.4;
    stroke-linecap: round;
    opacity: 0.7;
  }

  /* Face Lines */
  .line-face-contour {
    fill: none;
    stroke: var(--text);
    stroke-width: 1.8;
    opacity: 0.5;
  }

  .line-nose, .line-ref-eye, .line-lip-cupid, .line-lip-lower {
    fill: none;
    stroke: var(--text);
    stroke-width: 1.5;
    opacity: 0.6;
  }

  .line-guide-dash {
    stroke: var(--accent, #a9676b);
    stroke-width: 1.2;
    opacity: 0.45;
  }

  /* Blend Layers & Lighting */
  .blend-layer {
    mix-blend-mode: multiply;
    transition: opacity 0.3s ease, transform 0.3s ease;
  }

  :global(.dark) .blend-layer {
    mix-blend-mode: screen;
  }

  .zone-layer {
