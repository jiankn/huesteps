---
import { Image } from 'astro:assets';
import eyeChartImg from '@/assets/guides/eye-architecture-chart.webp';
import faceChartImg from '@/assets/guides/face-harmony-chart.webp';

interface Palette {
  name: string;
  hex: string;
  role: string;
  placement: string;
}

interface Props {
  palette: Palette[];
  notes: string[];
  title: string;
}

const { palette, notes, title } = Astro.props;

// Classify anatomical placement zones for each color
function analyzeZone(item: Palette, index: number) {
  const text = `${item.placement} ${item.role}`.toLowerCase();
  
  const isCrease = text.includes('crease') || text.includes('socket') || text.includes('fold') || text.includes('transition') || text.includes('above the natural');
  const isLashline = text.includes('lash') || text.includes('liner') || text.includes('roots') || text.includes('tightline') || text.includes('definition');
  const isInner = text.includes('inner') || text.includes('tear duct') || text.includes('brightener') || text.includes('champagne');
  const isOuter = text.includes('outer') || text.includes('corner') || text.includes('wing') || text.includes('angle');
  const isLid = text.includes('lid') || text.includes('mobile') || text.includes('accent') || (!isCrease && !isLashline && !text.includes('cheek') && !text.includes('lip'));
  const isCheek = text.includes('cheek') || text.includes('blush');
  const isLip = text.includes('lip');

  // Eye Chart Percentage coordinates on eye-architecture-chart.webp (1024x768)
  let eyePin = { percentX: 50, percentY: 46, label: 'Mobile Lid' };
  let eyeHotspot = { x: 50, y: 46, type: 'lid' };

  if (isLashline && isOuter) {
    eyePin = { percentX: 68, percentY: 54, label: 'Outer Lash Line' };
    eyeHotspot = { x: 68, y: 54, type: 'outer-lash' };
  } else if (isLashline) {
    eyePin = { percentX: 50, percentY: 50, label: 'Lash Roots' };
    eyeHotspot = { x: 50, y: 50, type: 'lash' };
  } else if (isInner && !isLid) {
    eyePin = { percentX: 34, percentY: 60, label: 'Tear Duct / Inner Corner' };
    eyeHotspot = { x: 34, y: 60, type: 'inner' };
  } else if (isCrease) {
    eyePin = { percentX: 50, percentY: 34, label: 'Above Crease' };
    eyeHotspot = { x: 50, y: 34, type: 'crease' };
  } else if (isOuter && isLid) {
    eyePin = { percentX: 62, percentY: 46, label: 'Outer Lid' };
    eyeHotspot = { x: 62, y: 46, type: 'outer-lid' };
  } else if (isInner && isLid) {
    eyePin = { percentX: 42, percentY: 48, label: 'Inner Lid' };
    eyeHotspot = { x: 42, y: 48, type: 'inner-lid' };
  } else if (isLid) {
    eyePin = { percentX: 50, percentY: 46, label: 'Lid Center' };
    eyeHotspot = { x: 50, y: 46, type: 'lid' };
  }

  // Face Chart Percentage coordinates on face-harmony-chart.webp (768x1024)
  let facePin: { percentX: number; percentY: number; label: string } | null = null;
  let faceHotspot = { x: 50, y: 48, type: 'cheek' };

  if (isCheek && isLip) {
    facePin = { percentX: 58, percentY: 55, label: 'Cheek & Lips' };
    faceHotspot = { x: 58, y: 55, type: 'cheek-lip' };
  } else if (isCheek) {
    facePin = { percentX: 50, percentY: 48, label: 'Upper Cheekbone' };
    faceHotspot = { x: 50, y: 48, type: 'cheek' };
  } else if (isLip) {
    facePin = { percentX: 70, percentY: 62, label: 'Lips Center' };
    faceHotspot = { x: 70, y: 62, type: 'lip' };
  }

  return {
    ...item,
    index: index + 1,
    isCrease,
    isLashline,
    isInner,
    isOuter,
    isLid,
    isCheek,
    isLip,
    eyePin,
    eyeHotspot,
    facePin,
    faceHotspot,
    hasFaceMapping: isCheek || isLip,
    hasEyeMapping: isCrease || isLashline || isInner || isOuter || isLid || (!isCheek && !isLip)
  };
}

const zones = palette.slice(0, 3).map((item, index) => analyzeZone(item, index));
const hasAnyFacePlacement = zones.some((z) => z.hasFaceMapping);
---

<figure class="placement-guide-revamp" aria-labelledby="placement-heading">
  <header class="placement-header">
    <div class="placement-title-wrap">
      <span class="placement-tag">Anatomical Zone Map</span>
      <h3 id="placement-heading">{title} Placement Guide</h3>
    </div>
    <p class="placement-instruction">
      Couture face chart mapping of shade placement, blend boundaries, and facial architecture. Hover or tap any card to spotlight its application area.
    </p>
  </header>

  <div class="placement-workbench">
    <!-- Visual Anatomy Diagrams Container -->
    <div class="placement-visuals" aria-label="Visual anatomical map of makeup application">
      <!-- Main Eye Anatomy Diagram -->
      <div class="anatomy-card eye-anatomy-card" data-diagram="eye">
        <div class="anatomy-card-header">
          <span class="anatomy-view-badge">👁️ Eye Architecture</span>
          <span class="anatomy-view-note">Pro face chart analysis</span>
        </div>
        
        <div class="chart-canvas-container eye-canvas">
          <Image
            src={eyeChartImg}
            alt="Editorial eye architecture face chart illustration"
            class="chart-master-image"
            widths={[480, 720, 1024]}
            sizes="(max-width: 768px) 100vw, 520px"
          />

          <!-- Soft Makeup Color Hotspots Layer -->
          <div class="chart-hotspots-layer" aria-hidden="true">
            {zones.map((zone) => {
              if (!zone.hasEyeMapping && zone.hasFaceMapping) return null;
              return (
                <div
                  class={`zone-hotspot eye-hotspot-${zone.eyeHotspot.type} zone-layer zone-layer-${zone.index}`}
                  data-zone-id={zone.index}
                  style={`--zone-color: ${zone.hex}; --hotspot-x: ${zone.eyeHotspot.x}%; --hotspot-y: ${zone.eyeHotspot.y}%;`}
                />
              );
            })}
          </div>

          <!-- Interactive Numbered Pins Layer -->
          <div class="chart-pins-layer">
            {zones.map((zone) => {
              if (!zone.hasEyeMapping && zone.hasFaceMapping) return null;
              return (
                <div
                  class={`chart-pin-group pin-group pin-group-${zone.index}`}
                  data-zone-id={zone.index}
                  style={`--pin-color: ${zone.hex}; left: ${zone.eyePin.percentX}%; top: ${zone.eyePin.percentY}%;`}
                  tabindex="0"
                  role="button"
                  aria-label={`Zone ${zone.index}: ${zone.name} applied to ${zone.eyePin.label}`}
                >
                  <span class="pin-halo"></span>
                  <span class="pin-base">{zone.index}</span>
                  <div class="pin-tooltip">
                    <span class="pin-tooltip-text">{zone.eyePin.label}</span>
                  </div>
                </div>
              );
            })}
          </div>
        </div>
      </div>

      <!-- Optional Face & Lip Harmony Diagram (rendered when cheek/lip colors exist) -->
      {hasAnyFacePlacement && (
        <div class="anatomy-card face-anatomy-card" data-diagram="face">
          <div class="anatomy-card-header">
            <span class="anatomy-view-badge">✨ Cheek & Lip Balance</span>
            <span class="anatomy-view-note">Facial contour mapping</span>
          </div>

          <div class="chart-canvas-container face-canvas">
            <Image
              src={faceChartImg}
              alt="Editorial facial contour and lip balance face chart"
              class="chart-master-image"
              widths={[360, 540, 768]}
              sizes="(max-width: 768px) 100vw, 360px"
            />

            <!-- Soft Makeup Color Hotspots Layer -->
            <div class="chart-hotspots-layer" aria-hidden="true">
              {zones.map((zone) => {
                if (!zone.hasFaceMapping) return null;
                return (
                  <div
                    class={`zone-hotspot face-hotspot-${zone.faceHotspot?.type} zone-layer zone-layer-${zone.index}`}
                    data-zone-id={zone.index}
                    style={`--zone-color: ${zone.hex}; --hotspot-x: ${zone.faceHotspot?.x}%; --hotspot-y: ${zone.faceHotspot?.y}%;`}
                  />
                );
              })}
            </div>

            <!-- Interactive Numbered Pins Layer -->
            <div class="chart-pins-layer">
              {zones.map((zone) => {
                if (!zone.hasFaceMapping || !zone.facePin) return null;
                return (
                  <div
                    class={`chart-pin-group pin-group pin-group-${zone.index}`}
                    data-zone-id={zone.index}
                    style={`--pin-color: ${zone.hex}; left: ${zone.facePin.percentX}%; top: ${zone.facePin.percentY}%;`}
                    tabindex="0"
                    role="button"
                    aria-label={`Zone ${zone.index}: ${zone.name} applied to ${zone.facePin.label}`}
                  >
                    <span class="pin-halo"></span>
                    <span class="pin-base">{zone.index}</span>
                    <div class="pin-tooltip">
                      <span class="pin-tooltip-text">{zone.facePin.label}</span>
                    </div>
                  </div>
                );
              })}
            </div>
          </div>
        </div>
      )}
    </div>

    <!-- Structured Palette Cards & Directives -->
    <div class="placement-legend">
      <div class="legend-header">
        <h4 class="legend-title">Step Palette & Targeted Placement</h4>
        <span class="legend-subtitle">Harmonized formula and anatomical target</span>
      </div>

      <ol class="placement-cards-list">
        {zones.map((zone) => (
          <li
            class={`placement-card zone-card-${zone.index}`}
            data-zone-id={zone.index}
            tabindex="0"
          >
            <div class="card-indicator">
              <span class="card-pin" style={`--swatch-color:${zone.hex}`}>
                {zone.index}
              </span>
            </div>
            <div class="card-main">
              <div class="card-top-row">
                <h5 class="shade-name">{zone.name}</h5>
                <span class="role-badge">{zone.role}</span>
              </div>
              <div class="card-placement-detail">
                <span class="placement-target-pin" aria-hidden="true">📍</span>
                <span class="placement-target-text">{zone.placement}</span>
              </div>
            </div>
          </li>
        ))}
      </ol>

      <!-- Editorial Placement Guidelines -->
      <div class="placement-directives-panel">
        <h5 class="directives-title">Pro Application Directives</h5>
        <ul class="directives-list">
          {notes.map((note) => (
            <li>{note}</li>
          ))}
        </ul>
        <p class="directives-note">
          💡 The numbered pins, anatomical diagrams, and written directives carry synchronized instructions. Click or hover any card to spotlight the exact region.
        </p>
      </div>
    </div>
  </div>
</figure>

<script>
  // Client-side interactive spotlight logic
  function initPlacementGuide() {
    const guides = document.querySelectorAll('.placement-guide-revamp');
    
    guides.forEach((guide) => {
      const cards = guide.querySelectorAll('.placement-card');
      const layers = guide.querySelectorAll('.zone-layer');
      const pins = guide.querySelectorAll('.pin-group');

      function setActiveZone(zoneId: string | null) {
        if (!zoneId) {
          cards.forEach((c) => c.classList.remove('is-active'));
          layers.forEach((l) => l.classList.remove('is-active', 'is-dimmed'));
          pins.forEach((p) => p.classList.remove('is-active', 'is-dimmed'));
          return;
        }

        cards.forEach((c) => {
          c.classList.toggle('is-active', c.getAttribute('data-zone-id') === zoneId);
        });

        layers.forEach((l) => {
          const match = l.getAttribute('data-zone-id') === zoneId;
          l.classList.toggle('is-active', match);
          l.classList.toggle('is-dimmed', !match);
        });

        pins.forEach((p) => {
          const match = p.getAttribute('data-zone-id') === zoneId;
          p.classList.toggle('is-active', match);
          p.classList.toggle('is-dimmed', !match);
        });
      }

      // Card event listeners
      cards.forEach((card) => {
        const zoneId = card.getAttribute('data-zone-id');
        
        card.addEventListener('mouseenter', () => setActiveZone(zoneId));
        card.addEventListener('focus', () => setActiveZone(zoneId));
        card.addEventListener('click', () => setActiveZone(zoneId));
      });

      // Pin event listeners
      pins.forEach((pin) => {
        const zoneId = pin.getAttribute('data-zone-id');
        
        pin.addEventListener('mouseenter', () => setActiveZone(zoneId));
        pin.addEventListener('click', () => setActiveZone(zoneId));
      });

      // Reset when pointer leaves the whole guide
      guide.addEventListener('mouseleave', () => setActiveZone(null));
    });
  }

  // Support initial load & client navigation (view transitions)
  initPlacementGuide();
  document.addEventListener('astro:page-load', initPlacementGuide);
</script>

<style>
  /* ==========================================================================
     Placement Guide Revamp Styles - Luxury Editorial Face Charts
     ========================================================================== */

  .placement-guide-revamp {
    margin: 24px 0 32px !important;
    padding: clamp(20px, 3vw, 28px);
    border: 1px solid var(--border);
    border-radius: 14px;
    background: var(--surface);
    box-shadow: 0 4px 24px -2px rgba(0, 0, 0, 0.04);
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }

  /* Header */
  .placement-header {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--border);
  }

  .placement-tag {
    display: inline-flex;
    align-items: center;
    width: fit-content;
    font-size: 0.72rem;
    font-weight: 750;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 0.25rem;
  }

  .placement-title-wrap h3 {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 2.5vw, 1.85rem);
    font-weight: 450;
    color: var(--text);
    line-height: 1.25;
  }

  .placement-instruction {
    margin: 0;
    font-size: 0.88rem;
    color: var(--text-muted);
    line-height: 1.5;
    max-width: 75ch;
  }

  /* Workbench Split Layout */
  .placement-workbench {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    gap: 2rem;
    align-items: start;
  }

  /* Visual Anatomy Cards */
  .placement-visuals {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .anatomy-card {
    background: #faf8f5;
    border: 1px solid var(--border);
    border-radius: 12px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.03);
    transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .anatomy-card:hover {
    border-color: color-mix(in srgb, var(--accent) 40%, var(--border));
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.07);
  }

  .anatomy-card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.75rem 1.15rem;
    background: color-mix(in srgb, var(--surface) 75%, #faf8f5);
    border-bottom: 1px solid var(--border);
    font-size: 0.8rem;
    z-index: 2;
  }

  .anatomy-view-badge {
    font-weight: 650;
    color: var(--text);
  }

  .anatomy-view-note {
    font-size: 0.74rem;
    color: var(--text-muted);
  }

  /* Canvas Container */
  .chart-canvas-container {
    position: relative;
    width: 100%;
    overflow: hidden;
    background: #faf8f5;
    user-select: none;
  }

  .eye-canvas {
    aspect-ratio: 4 / 3;
  }

  .face-canvas {
    aspect-ratio: 3 / 4;
  }

  .chart-master-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    mix-blend-mode: multiply;
  }

  /* Glowing Hotspot Layers */
  .chart-hotspots-layer {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .zone-hotspot {
    position: absolute;
    left: var(--hotspot-x, 50%);
    top: var(--hotspot-y, 50%);
    transform: translate(-50%, -50%);
    width: 110px;
    height: 80px;
    border-radius: 50%;
    background: radial-gradient(
      ellipse at center,
      color-mix(in srgb, var(--zone-color) 70%, transparent) 0%,
      color-mix(in srgb, var(--zone-color) 30%, transparent) 55%,
      transparent 80%
    );
    filter: blur(14px);
    opacity: 0.35;
    mix-blend-mode: multiply;
    transition: opacity 280ms cubic-bezier(.22,.61,.36,1), transform 280ms cubic-bezier(.22,.61,.36,1);
  }

  .zone-hotspot.is-active {
    opacity: 0.95;
    transform: translate(-50%, -50%) scale(1.25);
  }

  .zone-hotspot.is-dimmed {
    opacity: 0.12;
  }

  .eye-hotspot-crease {
    width: 160px;
    height: 60px;
    border-radius: 80% 80% 40% 40%;
  }

  .eye-hotspot-lash, .eye-hotspot-outer-lash {
    width: 120px;
    height: 45px;
    border-radius: 40% 40% 70% 70%;
  }

  .face-hotspot-cheek, .face-hotspot-cheek-lip {
    width: 130px;
    height: 90px;
    transform: translate(-50%, -50%) rotate(-15deg);
  }

  .face-hotspot-lip {
    width: 90px;
    height: 45px;
  }

  /* Interactive Numbered Pins */
  .chart-pins-layer {
    position: absolute;
    inset: 0;
    pointer-events: auto;
  }

  .chart-pin-group {
    position: absolute;
    transform: translate(-50%, -50%);
    cursor: pointer;
    z-index: 5;
    display: flex;
    align-items: center;
    justify-content: center;
    outline: none;
    transition: transform 220ms cubic-bezier(.22,.61,.36,1);
  }

  .pin-halo {
    position: absolute;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: var(--pin-color);
    opacity: 0.22;
    transform: scale(0.8);
    transition: transform 240ms cubic-bezier(.22,.61,.36,1), opacity 240ms ease;
  }

  .pin-base {
    position: relative;
    z-index: 2;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: var(--pin-color);
    color: #ffffff;
    font-family: var(--font-body);
    font-size: 0.74rem;
    font-weight: 750;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 2px solid #ffffff;
    box-shadow: 0 3px 10px rgba(0, 0, 0, 0.24);
    transition: transform 220ms cubic-bezier(.22,.61,.36,1), box-shadow 220ms ease;
  }

  .chart-pin-group:hover,
  .chart-pin-group.is-active {
    transform: translate(-50%, -50%) scale(1.18);
  }

  .chart-pin-group:hover .pin-halo,
  .chart-pin-group.is-active .pin-halo {
    transform: scale(1.4);
    opacity: 0.45;
  }

  .chart-pin-group:hover .pin-base,
  .chart-pin-group.is-active .pin-base {
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.35);
  }

  .chart-pin-group.is-dimmed {
    opacity: 0.35;
  }

  /* Pin Tooltips */
  .pin-tooltip {
    position: absolute;
    bottom: calc(100% + 8px);
    left: 50%;
    transform: translateX(-50%) translateY(4px);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    background: color-mix(in srgb, var(--surface) 92%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid var(--border);
    padding: 4px 10px;
    border-radius: 999px;
    white-space: nowrap;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.12);
    transition: opacity 180ms ease, transform 180ms ease, visibility 180ms ease;
    z-index: 10;
  }

  .pin-tooltip-text {
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--text);
  }

  .chart-pin-group:hover .pin-tooltip,
  .chart-pin-group.is-active .pin-tooltip {
    opacity: 1;
    visibility: visible;
    transform: translateX(-50%) translateY(0);
  }

  /* Right Column - Step Palette Cards */
  .placement-legend {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .legend-header {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .legend-title {
    margin: 0;
    font-size: 1.1rem;
    font-weight: 650;
    color: var(--text);
  }

  .legend-subtitle {
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  .placement-cards-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .placement-card {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.85rem 1rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 10px;
    cursor: pointer;
    transition: all 220ms cubic-bezier(.22,.61,.36,1);
    outline: none;
  }

  .placement-card:hover,
  .placement-card:focus-visible {
    border-color: color-mix(in srgb, var(--accent) 55%, var(--border));
    background: color-mix(in srgb, var(--surface-soft) 60%, var(--surface));
    transform: translateX(4px);
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.05);
  }

  .placement-card.is-active {
    border-color: var(--accent);
    background: var(--surface);
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.08);
    transform: translateX(6px);
  }

  .card-indicator {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .card-pin {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: var(--swatch-color);
    color: #ffffff;
    font-size: 0.78rem;
    font-weight: 750;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.2);
    border: 2px solid #ffffff;
  }

  .card-main {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    min-width: 0;
  }

  .card-top-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem;
  }

  .shade-name {
    margin: 0;
    font-size: 0.95rem;
    font-weight: 650;
    color: var(--text);
  }

  .role-badge {
    font-size: 0.7rem;
    font-weight: 650;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--text-muted);
    background: var(--surface-soft);
    padding: 2px 8px;
    border-radius: 999px;
    border: 1px solid var(--border);
  }

  .card-placement-detail {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  .placement-target-pin {
    font-size: 0.75rem;
  }

  .placement-target-text {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* Directives Panel */
  .placement-directives-panel {
    padding: 1.15rem;
    background: var(--surface-soft);
    border: 1px solid var(--border);
    border-radius: 10px;
