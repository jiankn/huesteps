---
import { getCollection } from 'astro:content';
import BaseLayout from '@/components/BaseLayout.astro';
import RecipeImage from '@/components/RecipeImage.astro';
import EditorialRecipeCard from '@/components/EditorialRecipeCard.astro';
import TrustStrip from '@/components/TrustStrip.astro';
import { SITE } from '@/lib/site';
import { getRecipeImage } from '@/lib/recipe-images';
import { getRecipeFocal } from '@/lib/recipe-focus';
import homeOccasionGolden from '@/assets/golden/home-occasion-golden-v3-2k.webp';
import taskEyeShape from '@/assets/home-v4/eye-shape-editorial-v1.webp';

const recipes = await getCollection('recipes');
const featured = recipes.filter((recipe) => recipe.data.featured).slice(0, 6);
const taskCards = [
  {
    number: '01',
    slug: 'occasion-makeup',
    title: 'Occasion Makeup',
    image: getRecipeImage('soft-glam-wedding-guest-makeup'),
    focal: getRecipeFocal('soft-glam-wedding-guest-makeup', 'card'),
    size: 'wide'
  },
  {
    number: '02',
    slug: 'eye-shape-makeup',
    title: 'Eye Shape Makeup',
    image: taskEyeShape,
    focal: { x: 44, y: 42, mobileX: 44, mobileY: 42 },
    size: 'tall'
  },
  {
    number: '03',
    slug: 'skin-tone-undertone',
    title: 'Skin Tone & Undertone',
    image: getRecipeImage('cool-rosy-makeup-fair-skin'),
    focal: getRecipeFocal('cool-rosy-makeup-fair-skin', 'card'),
    size: 'small'
  },
  {
    number: '04',
    slug: 'everyday-makeup',
    title: 'Everyday Makeup',
    image: getRecipeImage('5-minute-everyday-makeup'),
    focal: getRecipeFocal('5-minute-everyday-makeup', 'card'),
    size: 'small'
  }
];
const organizationSchema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': `${SITE.url}/#organization`,
    name: SITE.name,
    url: SITE.url,
    description: SITE.description
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': `${SITE.url}/#website`,
    name: SITE.name,
    url: SITE.url,
    publisher: { '@id': `${SITE.url}/#organization` }
  }
];
---

<BaseLayout title="HueSteps" description={SITE.description} schema={organizationSchema}>
  <section class="editorial-hero shell" id="find-a-look">
    <div class="hero-copy-panel">
      <h1>Makeup,<br /><em>step by step.</em></h1>
      <p class="hero-deck">Wearable makeup recipes for real-life occasions, adapted by eye shape and skin tone.</p>
      <p class="hero-note">Move from inspiration to a finished look, confidently.</p>
      <a class="button editorial-button" href="#choose-your-look">Find a look <span aria-hidden="true">→</span></a>
    </div>
    <div class="editorial-hero-media" aria-label="HueSteps makeup editorial">
      <RecipeImage
        src={homeOccasionGolden}
        alt="Close-up beauty editorial with copper-mauve eyes, rosewood glossy lips, and visible natural skin texture"
        focal={{ x: 62, y: 45, mobileX: 62, mobileY: 45 }}
        widths={[480, 720, 960, 1280, 1600, 1920, 2048]}
        priority
        sizes="(max-width: 820px) 100vw, 62vw"
      />
    </div>
  </section>

  <section class="editorial-section" id="choose-your-look">
    <div class="shell">
      <header class="editorial-section-heading">
        <div><h2>Choose your next look</h2></div>
        <p>Start with the detail that changes the answer.</p>
      </header>
      <div class="task-mosaic">
        {taskCards.map((task) => (
          <a class:list={['task-tile', `task-${task.size}`]} href={`/${task.slug}/`}>
            <RecipeImage src={task.image} alt="" focal={task.focal} sizes="(max-width: 640px) 100vw, 40vw" />
            <span class="task-number">{task.number}</span>
            <h3>{task.title}</h3>
            <span class="circle-arrow" aria-hidden="true">→</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="editorial-section featured-section">
    <div class="shell">
      <header class="editorial-section-heading compact-heading">
        <h2>Featured recipes</h2>
        <a class="text-link" href="/occasion-makeup/">View all recipes <span aria-hidden="true">→</span></a>
      </header>
      <div class="editorial-recipe-row">
        {featured.map((recipe) => <EditorialRecipeCard recipe={recipe} crop={recipe.data.hub === 'eye-shape-makeup' ? 'eye' : 'face'} />)}
      </div>
    </div>
  </section>

  <section class="process-band">
    <div class="shell process-grid">
      <div class="process-intro"><h2>Choose,<br />Follow,<br />Adapt</h2><p>A simple process for looks that truly fit you.</p></div>
      <ol>
        <li><span>1</span><div><h3>Choose</h3><p>Pick a look for your occasion, eye shape, or skin tone.</p></div></li>
        <li><span>2</span><div><h3>Follow</h3><p>Work through clear steps with exact placement.</p></div></li>
        <li><span>3</span><div><h3>Adapt</h3><p>Adjust shade, depth, and technique to make it your own.</p></div></li>
      </ol>
    </div>
  </section>

  <TrustStrip />
</BaseLayout>
