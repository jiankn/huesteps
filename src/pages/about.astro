---
import BaseLayout from '@/components/BaseLayout.astro';
import RecipeImage from '@/components/RecipeImage.astro';
import TrustStrip from '@/components/TrustStrip.astro';
import { Image } from 'astro:assets';
import { SITE } from '@/lib/site';
import { getRecipeImage } from '@/lib/recipe-images';
import { getRecipeFocal } from '@/lib/recipe-focus';
import aboutHeroImage from '@/assets/golden/home-occasion-golden-v3-2k.webp';
import eyeChart from '@/assets/guides/eye-architecture-chart.webp';
import faceChart from '@/assets/guides/face-harmony-chart.webp';

const pageTitle = `About ${SITE.name} · Our Philosophy & Editorial Standards`;
const pageDescription = 'How HueSteps transforms high-fashion beauty inspiration into wearable, anatomically precise makeup recipes tailored by eye shape and skin undertone.';

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'AboutPage',
    '@id': `${SITE.url}/about/#page`,
    name: pageTitle,
    description: pageDescription,
    url: `${SITE.url}/about/`,
    mainEntity: {
      '@type': 'Organization',
      name: SITE.name,
      url: SITE.url,
      logo: `${SITE.url}/favicon.svg`,
      description: SITE.description,
      contactPoint: {
        '@type': 'ContactPoint',
        email: SITE.email,
        contactType: 'editorial'
      }
    }
  }
];

const pillars = [
  {
    num: '01',
    kicker: 'Precision Architecture',
    title: 'Exact Anatomical Placement',
    copy: 'No vague instructions or guesswork. Every HueSteps shade is mapped to precise ocular and facial landmarks—crease depth, socket fold, outer V lift, and cheekbone uplifts.',
    tag: 'Millimeter Accuracy'
  },
  {
    num: '02',
    kicker: 'True Personalization',
    title: 'Adaptive by Shape & Undertone',
    copy: 'One technique never fits all. Our recipes systematically adapt for hooded, monolid, round, and deep-set eyes, while balancing depth across fair, olive, and deep complexions.',
    tag: 'Custom Fit'
  },
  {
    num: '03',
    kicker: 'Empowerment First',
    title: 'Product-Agnostic Mastery',
    copy: 'We teach color theory and formula roles—matte diffusion, satin washes, and micro-shimmer accents—so you can master any look using the makeup you already own.',
    tag: 'Zero Sponsored Bias'
  }
];

const trustPoints = [
  {
    icon: '🎯',
    title: 'One Recipe, One Model Identity',
    copy: 'Every look features a distinct, non-celebrity model identity maintained consistently from Pinterest discovery through every tutorial step to the final portrait.'
  },
  {
    icon: '🔍',
    title: 'Strict 8-Step Cumulative Flow',
    copy: 'Every tutorial progresses step-by-step from a clean base to the final look. No skipped techniques, sudden shifts, or hidden shortcuts.'
  },
  {
    icon: '✨',
    title: 'Natural Skin Texture Integrity',
    copy: 'We celebrate real human skin. Pores, fine texture, and authentic undertones are preserved with zero waxy smoothing or synthetic plastic filters.'
  },
  {
    icon: '🛡️',
    title: 'Transparent Editorial Review',
    copy: 'Every visual concept and technique is audited by human beauty editors for feasibility, anatomical accuracy, and color harmony.'
  }
];

const stats = [
  { value: '24', label: 'Bespoke Recipes', desc: 'Crafted for real-life occasions' },
  { value: '192', label: 'Verified Steps', desc: 'Step-by-step cumulative visuals' },
  { value: '6', label: 'Eye Architectures', desc: 'Hooded, Monolid, Round & more' },
  { value: '5', label: 'Undertone Profiles', desc: 'Fair, Olive, Medium, Deep' }
];

const hubCards = [
  { slug: 'occasion-makeup', title: 'Occasion Makeup', subtitle: 'Event & Setting Guides', hero: 'soft-glam-wedding-guest-makeup' },
  { slug: 'eye-shape-makeup', title: 'Eye Shape Makeup', subtitle: 'Architecture & Placement', hero: 'soft-glam-hooded-eyes' },
  { slug: 'skin-tone-undertone', title: 'Skin Tone & Undertone', subtitle: 'Shade & Complexion Harmony', hero: 'cool-rosy-makeup-fair-skin' },
  { slug: 'everyday-makeup', title: 'Everyday Makeup', subtitle: '5, 15 & 20-Minute Routines', hero: '5-minute-everyday-makeup' }
];
---

<BaseLayout title={pageTitle} description={pageDescription} schema={schema}>
  <div class="about-page">
    {/* Hero Section */}
    <section class="about-hero shell">
      <div class="about-hero-grid">
        <div class="about-hero-content">
          <span class="editorial-kicker">Brand Manifesto & Standards</span>
          <h1>Makeup, demystified.<br /><em>Step by step.</em></h1>
          <p class="about-hero-lede">
            HueSteps transforms high-fashion beauty inspiration into wearable, anatomically precise makeup recipes tailored for your unique eye shape and skin undertone.
          </p>
          <div class="about-hero-actions">
            <a class="button editorial-button" href="#philosophy">
              Explore Our Philosophy <span aria-hidden="true">↓</span>
            </a>
            <a class="text-link" href="#standards">
              Editorial Standards <span aria-hidden="true">→</span>
            </a>
          </div>
        </div>

        <div class="about-hero-media-wrapper">
          <div class="about-hero-media-card">
            <RecipeImage
              src={aboutHeroImage}
              alt="High-fashion close-up beauty portrait with warm neutral makeup and authentic skin texture"
              focal={{ x: 60, y: 44, mobileX: 60, mobileY: 44 }}
              widths={[480, 720, 960, 1280]}
              priority
              sizes="(max-width: 820px) 100vw, 45vw"
            />
            {/* Floating Face Chart Badge */}
            <div class="about-floating-art-card">
              <div class="art-card-thumb">
                <Image src={eyeChart} alt="Eye anatomy placement chart" width={120} height={90} quality={80} format="webp" />
              </div>
              <div class="art-card-meta">
                <span class="art-tag">📐 Anatomical Blueprint</span>
                <strong>Targeted Ocular Mapping</strong>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    {/* Philosophy Pillars Section */}
    <section class="about-section about-pillars-section" id="philosophy">
      <div class="shell">
        <header class="editorial-section-heading">
          <div>
            <span class="editorial-kicker">Core Methodology</span>
            <h2>How HueSteps changes the way you learn makeup</h2>
          </div>
          <p>Moving from random viral trends to repeatable, structured mastery.</p>
        </header>

        <div class="about-pillars-grid">
          {pillars.map((pillar) => (
            <article class="about-pillar-card">
              <div class="pillar-header">
                <span class="pillar-num">{pillar.num}</span>
                <span class="pillar-tag">{pillar.tag}</span>
              </div>
              <span class="pillar-kicker">{pillar.kicker}</span>
              <h3>{pillar.title}</h3>
              <p>{pillar.copy}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    {/* Art Meets Science Spotlight Band */}
    <section class="about-spotlight-band">
      <div class="shell about-spotlight-grid">
        <div class="spotlight-visuals">
          <div class="spotlight-chart-frame">
            <Image src={faceChart} alt="Face harmony placement face chart" width={600} height={800} quality={85} format="webp" class="spotlight-chart-img" />
            <div class="spotlight-chart-badge">
              <span>Face Harmony Chart</span>
              <small>3/4 Contour & Lip Balance</small>
            </div>
          </div>
        </div>

        <div class="spotlight-copy">
          <span class="editorial-kicker">The Teaching Canvas</span>
          <h2>Visualizing makeup as anatomical architecture</h2>
          <p>
            Every face is an interplay of bone structure, lid depth, and color temperature. Instead of generic "swatch and hope" advice, we illustrate the mechanics of light and shade on couture face charts.
          </p>
          <ul class="spotlight-features">
            <li>
              <strong>Socket Depth vs. Lid Surface</strong>
              <span>Differentiating crease placement for hooded and deep-set eyes so depth stays visible with open eyes.</span>
            </li>
            <li>
              <strong>Light & Undertone Calibration</strong>
              <span>Preventing muddy or ashy shifts by matching undertone temperature across foundation, blush, and lips.</span>
            </li>
            <li>
              <strong>Effortless Recovery Steps</strong>
              <span>Every recipe includes proactive fixes for over-application, fallout, or harsh blend edges.</span>
            </li>
          </ul>
        </div>
      </div>
    </section>

    {/* Trust & Transparency Contract */}
    <section class="about-section about-trust-section" id="standards">
      <div class="shell">
        <header class="editorial-section-heading">
          <div>
            <span class="editorial-kicker">The HueSteps Promise</span>
            <h2>Our Visual Trust & Integrity Contract</h2>
          </div>
          <p>A non-negotiable standard for every current and future tutorial.</p>
        </header>

        <div class="about-trust-grid">
          {trustPoints.map((point) => (
            <div class="about-trust-card">
              <span class="trust-icon" aria-hidden="true">{point.icon}</span>
              <h3>{point.title}</h3>
              <p>{point.copy}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    {/* By The Numbers Bar */}
    <section class="about-stats-band">
      <div class="shell">
        <div class="about-stats-grid">
          {stats.map((stat) => (
            <div class="about-stat-item">
              <strong class="stat-value">{stat.value}</strong>
              <span class="stat-label">{stat.label}</span>
              <small class="stat-desc">{stat.desc}</small>
            </div>
          ))}
        </div>
      </div>
    </section>

    {/* Discover The Guides CTA */}
    <section class="about-section about-hubs-section">
      <div class="shell">
        <header class="editorial-section-heading compact-heading">
          <div>
            <span class="editorial-kicker">Start Learning</span>
            <h2>Explore our curated collections</h2>
          </div>
          <a class="text-link" href="/occasion-makeup/">View all 24 guides <span aria-hidden="true">→</span></a>
        </header>

        <div class="about-hubs-grid">
          {hubCards.map((card) => {
            const imgRecipe = getRecipeImage(card.hero);
            const imgFocal = getRecipeFocal(card.hero, 'card');
            return (
              <a class="about-hub-card" href={`/${card.slug}/`}>
                <div class="hub-card-media">
                  <RecipeImage src={imgRecipe} alt="" focal={imgFocal} sizes="(max-width: 640px) 100vw, 25vw" />
                </div>
                <div class="hub-card-body">
                  <span class="hub-subtitle">{card.subtitle}</span>
                  <h3>{card.title}</h3>
                  <span class="circle-arrow" aria-hidden="true">→</span>
                </div>
              </a>
            );
          })}
        </div>
      </div>
    </section>

    {/* Editorial Team & Corrections Note */}
    <section class="about-editorial-footer shell">
      <div class="editorial-footer-card">
        <div class="footer-card-copy">
          <span class="editorial-kicker">Editorial Inquiries & Corrections</span>
          <h3>Published with transparency by the HueSteps Editorial Team</h3>
          <p>
            We take accuracy and community trust seriously. If you spot a color inaccuracy, step mismatch, or accessibility issue, our editorial desk reviews every submission.
          </p>
        </div>
        <div class="footer-card-actions">
          <a class="button editorial-button" href={`mailto:${SITE.email}`}>
            Email Editorial Desk <span aria-hidden="true">✉</span>
          </a>
          <a class="text-link" href="/contact-corrections/">
            Read Corrections Policy <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </section>
  </div>

  <TrustStrip />
</BaseLayout>

<style>
  .about-page {
    padding-bottom: clamp(60px, 8vw, 100px);
  }

  /* Kicker Tag */
  .editorial-kicker {
    display: inline-block;
    font-family: var(--font-body);
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 12px;
  }

  /* Hero Section */
  .about-hero {
    padding-block: clamp(32px, 5vw, 64px) clamp(48px, 6vw, 80px);
  }

  .about-hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.95fr);
    gap: clamp(36px, 5vw, 72px);
    align-items: center;
  }

  .about-hero-content h1 {
    font-size: clamp(2.8rem, 5vw, 4.4rem);
    font-weight: 420;
    line-height: 1.08;
    letter-spacing: -0.035em;
    margin: 0 0 1.25rem;
    color: var(--text);
  }

  .about-hero-content h1 em {
    font-style: italic;
    font-weight: 360;
    color: var(--accent);
  }

  .about-hero-lede {
    font-size: clamp(1.15rem, 1.7vw, 1.35rem);
    line-height: 1.5;
    color: var(--text-muted);
    max-width: 36ch;
    margin: 0 0 2rem;
  }

  .about-hero-actions {
    display: flex;
    align-items: center;
    gap: 20px;
    flex-wrap: wrap;
  }

  .about-hero-media-wrapper {
    position: relative;
  }

  .about-hero-media-card {
    position: relative;
    border-radius: var(--radius);
    overflow: hidden;
    aspect-ratio: 4 / 3;
    border: 1px solid var(--border);
    box-shadow: 0 16px 40px rgb(18 19 20 / 0.08);
    background: var(--surface-strong);
  }

  .about-hero-media-card :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .about-floating-art-card {
    position: absolute;
    bottom: 16px;
    left: 16px;
    right: 16px;
    background: rgb(255 255 255 / 0.88);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid rgb(255 255 255 / 0.7);
    border-radius: 12px;
    padding: 10px 14px;
    display: flex;
    align-items: center;
    gap: 14px;
    box-shadow: 0 10px 24px rgb(0 0 0 / 0.08);
  }

  .art-card-thumb {
    width: 58px;
    height: 44px;
    border-radius: 6px;
    overflow: hidden;
    flex-shrink: 0;
    border: 1px solid var(--border);
    background: #FAF8F5;
  }

  .art-card-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .art-card-meta {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .art-tag {
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .art-card-meta strong {
    font-size: 0.84rem;
    font-weight: 600;
    color: var(--text);
  }

  /* Pillars Section */
  .about-section {
    padding-block: clamp(48px, 6vw, 88px);
  }

  .about-pillars-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }

  .about-pillar-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: clamp(24px, 3vw, 36px);
    display: flex;
    flex-direction: column;
    transition: transform 200ms ease, box-shadow 200ms ease;
  }

  .about-pillar-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 12px 32px rgb(18 19 20 / 0.06);
  }

  .pillar-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 16px;
  }

  .pillar-num {
    font-family: var(--font-display);
    font-size: 1.8rem;
    font-weight: 350;
    color: var(--accent);
    line-height: 1;
  }

  .pillar-tag {
    font-size: 0.68rem;
    font-weight: 650;
    letter-spacing: 0.04em;
    padding: 3px 8px;
    border-radius: 999px;
    background: var(--surface-soft);
    color: var(--text-muted);
    border: 1px solid var(--border);
  }

  .pillar-kicker {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-bottom: 6px;
  }

  .about-pillar-card h3 {
    font-size: 1.35rem;
    font-weight: 600;
    margin: 0 0 12px;
    color: var(--text);
    line-height: 1.25;
  }

  .about-pillar-card p {
    font-size: 0.92rem;
    line-height: 1.6;
    color: var(--text-muted);
    margin: 0;
  }

  /* Spotlight Band */
  .about-spotlight-band {
    margin-block: clamp(40px, 5vw, 70px);
    padding-block: clamp(54px, 7vw, 96px);
    background: #FAF8F5;
    border-block: 1px solid var(--border);
  }

  .about-spotlight-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: clamp(40px, 6vw, 80px);
    align-items: center;
  }

  .spotlight-visuals {
    position: relative;
    display: flex;
    justify-content: center;
  }

  .spotlight-chart-frame {
    position: relative;
    width: 100%;
    max-width: 420px;
    aspect-ratio: 3 / 4;
    border-radius: var(--radius);
    overflow: hidden;
    border: 1px solid var(--border);
    background: #ffffff;
    box-shadow: 0 18px 40px rgb(0 0 0 / 0.06);
  }

  .spotlight-chart-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .spotlight-chart-badge {
    position: absolute;
    bottom: 14px;
    left: 14px;
    right: 14px;
    background: rgb(255 255 255 / 0.92);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    padding: 10px 14px;
    border-radius: 10px;
    border: 1px solid var(--border);
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .spotlight-chart-badge span {
    font-size: 0.84rem;
    font-weight: 650;
    color: var(--text);
  }

  .spotlight-chart-badge small {
    font-size: 0.72rem;
    color: var(--text-muted);
  }

  .spotlight-copy h2 {
    font-size: clamp(2.2rem, 3.6vw, 3.2rem);
    font-weight: 420;
    line-height: 1.15;
    letter-spacing: -0.03em;
    margin: 0 0 1.25rem;
    color: var(--text);
  }

  .spotlight-copy > p {
    font-size: 1.05rem;
    line-height: 1.6;
    color: var(--text-muted);
    margin: 0 0 2rem;
  }

  .spotlight-features {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .spotlight-features li {
    padding-left: 20px;
    border-left: 2px solid var(--accent);
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .spotlight-features strong {
    font-size: 0.98rem;
    color: var(--text);
    font-weight: 600;
  }

  .spotlight-features span {
    font-size: 0.88rem;
    line-height: 1.5;
    color: var(--text-muted);
  }

  /* Trust Matrix */
  .about-trust-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
  }

  .about-trust-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: clamp(24px, 3vw, 32px);
  }

  .trust-icon {
    font-size: 1.8rem;
    display: inline-block;
    margin-bottom: 14px;
  }

  .about-trust-card h3 {
    font-size: 1.18rem;
    font-weight: 600;
    margin: 0 0 10px;
    color: var(--text);
  }

  .about-trust-card p {
    font-size: 0.9rem;
    line-height: 1.55;
    color: var(--text-muted);
    margin: 0;
  }

  /* Stats Band */
  .about-stats-band {
    background: var(--surface-strong);
    border-block: 1px solid var(--border);
    padding-block: clamp(36px, 4vw, 54px);
    margin-block: clamp(30px, 4vw, 60px);
  }

  .about-stats-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
    text-align: center;
  }

  .about-stat-item {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .stat-value {
    font-family: var(--font-display);
    font-size: clamp(2.8rem, 4vw, 3.8rem);
    font-weight: 400;
    line-height: 1;
    color: var(--accent);
    margin-bottom: 6px;
  }

  .stat-label {
    font-size: 0.92rem;
    font-weight: 650;
    color: var(--text);
    margin-bottom: 4px;
  }

  .stat-desc {
    font-size: 0.76rem;
    color: var(--text-muted);
  }

  /* Hubs Cards Grid */
  .about-hubs-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
  }

  .about-hub-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
    transition: transform 200ms ease, box-shadow 200ms ease;
  }

  .about-hub-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 12px 28px rgb(18 19 20 / 0.08);
  }

  .hub-card-media {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--surface-soft);
  }

  .hub-card-media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 400ms ease;
  }

  .about-hub-card:hover .hub-card-media :global(img) {
    transform: scale(1.04);
  }

  .hub-card-body {
    padding: 16px;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    position: relative;
  }

  .hub-subtitle {
    font-size: 0.72rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--accent);
    margin-bottom: 4px;
  }

  .hub-card-body h3 {
    font-size: 1.05rem;
    font-weight: 600;
    margin: 0;
    color: var(--text);
  }

  .hub-card-body .circle-arrow {
    position: absolute;
    bottom: 14px;
    right: 14px;
    width: 24px;
    height: 24px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: var(--surface-soft);
    border: 1px solid var(--border);
    font-size: 0.8rem;
    color: var(--text);
    transition: background 160ms ease, color 160ms ease, transform 160ms ease;
  }

  .about-hub-card:hover .circle-arrow {
    background: var(--accent);
    color: white;
    transform: translateX(2px);
  }

  /* Editorial Footer Card */
  .about-editorial-footer {
    margin-top: clamp(40px, 6vw, 80px);
  }

  .editorial-footer-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: clamp(28px, 4vw, 44px);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
