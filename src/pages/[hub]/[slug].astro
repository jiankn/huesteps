---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '@/components/BaseLayout.astro';
import RecipeImage from '@/components/RecipeImage.astro';
import RecipeCard from '@/components/RecipeCard.astro';
import PlacementGuide from '@/components/PlacementGuide.astro';
import ProductSuggestions from '@/components/ProductSuggestions.astro';
import TutorialSteps from '@/components/TutorialSteps.astro';
import EditorialReview from '@/components/EditorialReview.astro';
import { getRecipeImage } from '@/lib/recipe-images';
import { getRecipeFocal } from '@/lib/recipe-focus';
import { HUBS, SITE, recipeUrl } from '@/lib/site';

export async function getStaticPaths() {
  const recipes = await getCollection('recipes');
  return recipes.map((recipe) => ({
    params: { hub: recipe.data.hub, slug: recipe.data.slug },
    props: { recipe, allRecipes: recipes }
  }));
}

interface Props {
  recipe: CollectionEntry<'recipes'>;
  allRecipes: CollectionEntry<'recipes'>[];
}

const { recipe, allRecipes } = Astro.props;
const { data } = recipe;
const image = getRecipeImage(data.heroImage);
const related = data.relatedRecipes
  .map((slug) => allRecipes.find((entry) => entry.data.slug === slug))
  .filter((entry): entry is CollectionEntry<'recipes'> => Boolean(entry));
const canonical = `${SITE.url}${recipeUrl(data.hub, data.slug)}`;
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: data.title,
    description: data.description,
    datePublished: data.publishedAt.toISOString(),
    dateModified: data.updatedAt.toISOString(),
    author: { '@type': 'Organization', name: SITE.author, url: `${SITE.url}/about/` },
    publisher: { '@id': `${SITE.url}/#organization` },
    mainEntityOfPage: canonical,
    image: `${SITE.url}/pins/${data.slug}-final.png`
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
      { '@type': 'ListItem', position: 2, name: HUBS[data.hub].title, item: `${SITE.url}/${data.hub}/` },
      { '@type': 'ListItem', position: 3, name: data.title, item: canonical }
    ]
  }
];
---

<BaseLayout title={data.title} description={data.description} image={`/pins/${data.slug}-final.png`} type="article" schema={schema}>
  <article>
    <header class="recipe-workbench-hero">
      <div class="shell recipe-hero-grid">
        <div class="hero-copy">
          <nav class="recipe-breadcrumbs" aria-label="Breadcrumb">
            <a href="/">Home</a><span aria-hidden="true">/</span><a href={`/${data.hub}/`}>{HUBS[data.hub].title}</a>
          </nav>
          <h1>{data.title}</h1>
          <p class="lede">{data.directAnswer}</p>
          <p class="recipe-byline">By <a href="/about/">HueSteps Editorial Team</a> · Updated <time datetime={data.updatedAt.toISOString().slice(0, 10)}>{data.updatedAt.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}</time></p>
          <div class="recipe-meta">
            <span>{data.timeMinutes} min</span>
            <span>{data.difficulty}</span>
            <span>{data.finish}</span>
          </div>
          <a class="button" href="#steps">Start the step-by-step tutorial</a>
        </div>
        <div class="hero-media-wrap">
          <div class="hero-media">
            <RecipeImage src={image} alt={data.heroAlt} focal={getRecipeFocal(data.heroImage, data.hub === 'eye-shape-makeup' ? 'eye' : 'hero')} priority sizes="(max-width: 820px) 100vw, 58vw" />
          </div>
          {data.aiGenerated && <p class="image-disclosure">AI-generated makeup visualization. It is not a claim of first-hand product use or wear testing.</p>}
        </div>
      </div>
    </header>

    <section class="shell section-compact" aria-labelledby="quick-facts-title">
      <h2 class="sr-only" id="quick-facts-title">Quick facts</h2>
      <dl class="quick-facts workbench-facts">
        <div class="fact"><dt>Time</dt><dd>{data.timeMinutes} minutes</dd></div>
        <div class="fact"><dt>Difficulty</dt><dd>{data.difficulty}</dd></div>
        <div class="fact"><dt>Finish</dt><dd>{data.finish}</dd></div>
        <div class="fact"><dt>Best for</dt><dd>{data.eyeShapes.slice(0, 2).join(', ')} eyes</dd></div>
        <div class="fact"><dt>Occasion</dt><dd>{data.occasions.join(', ')}</dd></div>
      </dl>
    </section>

    <div class="shell section recipe-layout workbench-layout">
      <aside class="recipe-toc workbench-rail" aria-label="Recipe stages">
        <h2>Recipe stages</h2>
        <a href="#look-recipe"><span>01</span><strong>Look</strong></a>
        <a href="#before-you-start"><span>02</span><strong>Kit</strong></a>
        <a href="#steps"><span>03</span><strong>Steps</strong></a>
        <a href="#placement"><span>04</span><strong>Placement</strong></a>
        <a href="#adaptations"><span>05</span><strong>Adapt</strong></a>
        <a href="#mistakes"><span>06</span><strong>Fixes</strong></a>
        <a href="#faq"><span>07</span><strong>FAQ</strong></a>
        <a href="#products"><span>08</span><strong>Products</strong></a>
      </aside>

      <div class="recipe-content">
        <section id="look-recipe" class="workbench-section">
          <header class="workbench-section-heading"><span>01</span><div><p class="section-label">Color and product roles</p><h2>The look recipe</h2><p>Match each function with products you already own before shopping.</p></div></header>
          <div class="palette-list">
            {data.palette.map((color) => (
              <article class="palette-item">
                <span class="palette-swatch" style={`--swatch:${color.hex}`} aria-hidden="true"></span>
                <div><h3>{color.name}</h3><p><strong>{color.role}.</strong> Place it {color.placement}.</p></div>
              </article>
            ))}
          </div>
          <div class="look-logic">
            <h3>What makes this look work</h3>
            <ul>{data.whatMakesItWork.map((item) => <li>{item}</li>)}</ul>
          </div>
        </section>

        <section id="before-you-start" class="workbench-section">
          <header class="workbench-section-heading"><span>02</span><div><h2>Your kit and prep</h2><p>Use products you already own when their role and texture match.</p></div></header>
          <div class="tool-list">
            {data.tools.map((tool) => (
              <article class="tool-item"><h3>{tool.name}</h3><p>{tool.purpose}</p><p><strong>Substitute:</strong> {tool.substitute}</p></article>
            ))}
          </div>
          <h3 class="prep-heading">Before you start</h3>
          <ul class="prep-list">{data.beforeYouStart.map((item) => <li>{item}</li>)}</ul>
        </section>

        <TutorialSteps steps={data.steps} />

        <section id="placement" class="workbench-section">
          <header class="workbench-section-heading"><span>04</span><div><h2>Placement guide</h2><p>Use the open-eye view as your working map.</p></div></header>
          <p>The diagram is a map, not an anatomical template. Use the open-eye adjustments below when your eye shape changes what remains visible.</p>
          <PlacementGuide palette={data.palette} notes={data.placementNotes} title={data.title} />
        </section>

        <section id="final-check" class="workbench-section finish-check-section">
          <header class="workbench-section-heading"><span>✓</span><div><h2>Final result checklist</h2><p>Check the whole look before correcting any one detail.</p></div></header>
          <ul class="finish-checklist">{data.finishChecklist.map((item) => <li>{item}</li>)}</ul>
        </section>

        <section id="adaptations" class="workbench-section">
          <header class="workbench-section-heading"><span>05</span><div><h2>Make it work for you</h2><p>Change placement, depth, or texture without losing the look.</p></div></header>
          <div class="adaptation-grid">
            {data.adjustments.map((item) => (
              <article class="adaptation"><h3>{item.for}</h3><p><strong>Change:</strong> {item.change}</p><p><strong>Why:</strong> {item.why}</p></article>
            ))}
          </div>
        </section>

        <section id="mistakes" class="workbench-section">
          <header class="workbench-section-heading"><span>06</span><div><h2>Common mistakes and fixes</h2><p>Correct the result before adding more product.</p></div></header>
          <div class="mistake-list">
            {data.commonMistakes.map((item) => (
              <article class="mistake"><h3>{item.problem}</h3><p><strong>Likely cause:</strong> {item.cause}</p><p><strong>Fix:</strong> {item.fix}</p></article>
            ))}
          </div>
        </section>

        <section id="faq" class="workbench-section faq-section">
          <header class="workbench-section-heading"><span>07</span><div><h2>Questions before you try it</h2><p>Short answers to the decisions and failure points most likely to change this result.</p></div></header>
          <div class="faq-list">
            {data.faq.map((item) => <article><h3>{item.question}</h3><p>{item.answer}</p></article>)}
          </div>
        </section>

        <div id="products" class="workbench-section">
          <ProductSuggestions products={data.suggestedProducts} />
        </div>

        <EditorialReview
          publishedAt={data.publishedAt}
          updatedAt={data.updatedAt}
          authorName="HueSteps Editorial Team"
          reviewerName="HueSteps Editorial Team"
          aiGenerated={data.aiGenerated}
          sources={data.sources}
        />

        <section id="related" class="workbench-section related-section">
          <header class="workbench-section-heading"><span>08</span><div><h2>Related recipes</h2><p>Continue with a nearby occasion, placement goal, or color decision.</p></div></header>
          <div class="related-grid">{related.map((entry) => <RecipeCard recipe={entry} />)}</div>
        </section>
      </div>
    </div>
  </article>
</BaseLayout>
